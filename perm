#!/bin/bash

VERSION="3.4"

# ============================================================
# perm - Linux Permission Analyzer
# Version 3.4
# ============================================================

# -----------------------------
# Colors
# -----------------------------
# Colors are enabled only when:
#   - the output stream is a terminal, and
#   - NO_COLOR is unset or empty (https://no-color.org)
# stdout and stderr are checked separately, so that
#   perm file > out.txt      keeps error messages colored on the terminal
#   perm file 2> err.txt     keeps normal output colored on the terminal

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    MAGENTA='\033[0;35m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE=''
    CYAN='' MAGENTA='' BOLD='' RESET=''
fi

if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
    ERR_RED='\033[0;31m'
    ERR_RESET='\033[0m'
else
    ERR_RED=''
    ERR_RESET=''
fi


# ============================================================
# General Functions
# ============================================================

show_version() {
    echo "perm version $VERSION"
}


show_help() {
    cat << EOF

perm - Linux Permission Analyzer

Usage:
    perm [OPTIONS] PATH
    perm --compare [OPTIONS] FILE1 FILE2
    perm --explain VALUE
    perm --baseline [--force] PATH
    perm --check [--json] PATH
    perm --list [--json]
    perm --remove PATH
    perm --baseline --strict PATH
    perm --scan [--recursive] [--force] DIR
    perm --scan [--recursive] --check [--json | --changes-only] DIR
    perm --why [--json] USER ACTION PATH

General Options:
    -h, --help              Show this help message
    -v, --version           Show version

Analysis:
    PATH                    Analyze file or directory
    --report PATH           Generate structured report
    --security PATH         Run security-focused analysis
    --quiet PATH            Print only permission string

Explanation:
    --explain VALUE         Explain numeric permission
                            Example: perm --explain 755

Comparison:
    --compare FILE1 FILE2   Compare two files
    --permissions           Compare permissions only
    --ownership             Compare ownership only
    --special               Compare special bits only
    --diff                  Show only actual differences

Baseline / Change Detection:
    --baseline PATH         Save the current state of PATH as a baseline
    --force                 Overwrite an existing baseline (with --baseline)
    --strict                With --baseline: also record a SHA-256 hash of
                            the file's content. --check then detects
                            content changes too (exit code 1), not just
                            permissions/ownership/special bits.
                            Only regular files are supported.
                            Once a baseline tracks content, updating it
                            with --force also requires --strict.
    --check PATH            Compare PATH with its saved baseline

                            Tracked (changes => exit code 1):
                              permissions (rwx), ownership,
                              special bits, file type,
                              and deletion of the target
                            Informational only ([NOTE]):
                              size, inode
                            File contents: tracked only if the baseline
                            was created with --strict

                            Baselines are stored in:
                              ${XDG_DATA_HOME:-~/.local/share}/perm/baselines/

Directory Scan:
    --scan DIR              Create a baseline for every file in DIR
                            Files that already have one are left alone
                            ([EXISTS]); use --force to update them.
                            Subdirectories are not entered ([SKIP]).
                            --strict is not supported with --scan.
    --scan --recursive DIR  Also enter every subdirectory (any depth).
                            Directories get a baseline too (a directory
                            that becomes 777, or is replaced by a file,
                            is reported). Names are shown relative to DIR.
                            Symbolic links are never followed. File
                            system boundaries are never crossed: mount
                            points, and perm's own baseline store, are
                            [SKIP]ped. A directory that cannot be read is
                            an [ERROR] (the result is then incomplete).
                            Run with sudo to scan trees you cannot read.
    --changes-only          With --scan: hide the [OK] and [EXISTS] rows
                            (text output only; the counts and the exit
                            code are not affected).
    --scan --check DIR      Compare every file in DIR with its baseline
                            [OK] [CHANGED] [NEW] [DELETED] [INVALID]
                            [ERROR] [SKIP]
                            Exit code: 0 = all unchanged,
                                       1 = changed/new/deleted/invalid,
                                       2 = error (DIR unusable, or at least
                                           one file could not be checked)
                            DIR itself must not be a symbolic link.

Baseline Management:
    --list                  List all stored baselines
                            Status: exists   = target found
                                    missing  = target not found (deleted,
                                               or not accessible to you)
                                    invalid  = baseline file is damaged
                            The CONTENT column shows "sha256" when a
                            baseline also tracks content, "-" otherwise.
    --remove PATH           Delete the baseline of PATH
                            (only the baseline is deleted, never PATH itself;
                            works even if PATH no longer exists)

Effective Access:
    --why USER ACTION PATH  Explain whether USER can read, write or execute
                            PATH, and why (not).
                            ACTION: read, write, execute, delete
                                    (or r, w, x, d)
                            USER:   a user name or a numeric UID
                            Follows the kernel's rules:
                              - search permission (x) is needed on EVERY
                                directory of the path
                              - symbolic links are followed (max 40)
                              - only the FIRST matching class is checked:
                                owner, then group, then others
                              - on a directory, write needs w and x
                              - delete (unlink/rmdir of the last path
                                component, which is not followed) needs
                                w and x on the PARENT directory; the
                                entry's own mode is irrelevant. With the
                                sticky bit only the entry's owner, the
                                directory's owner or root may delete
                              - mount options: ro blocks write/delete,
                                noexec blocks execute (even for root)
                              - ACL entries are only DETECTED (warning)
                              - uid 0 bypasses r/w; executing a file still
                                needs at least one x bit
                            Not considered: ACL evaluation,
                            SELinux/AppArmor, capabilities, chattr +i.
                            Exit code: 0 = allowed, 1 = denied, 2 = error.
                            Run perm with sudo to inspect paths that the
                            current user cannot traverse.

Machine Readable:
    --json PATH             Output JSON (also works with --check, --list,
                            --scan --check, and --why)

Exit Codes:
    0   No differences / no change / successful operation
    1   Differences detected / change detected
    2   Error / invalid usage (includes: no baseline exists)
        (--why: 0 = access allowed, 1 = access denied)

Environment:
    NO_COLOR                Disable colored output
                            (colors are also disabled when output
                            is not a terminal)

Examples:
    perm /etc/passwd
    perm --report /etc/passwd
    perm --security /etc/passwd

    perm --explain 755
    perm --explain 6755

    perm --compare file1 file2
    perm --compare --permissions file1 file2
    perm --compare --special file1 file2
    perm --compare --diff file1 file2

    perm --json /etc/passwd
    perm --json --compare file1 file2

    perm --baseline /usr/bin/sudo
    perm --check /usr/bin/sudo
    perm --json --check /usr/bin/sudo
    perm --baseline --force /usr/bin/sudo

    perm --list
    perm --json --list
    perm --remove /usr/bin/sudo

    perm --baseline --strict /usr/bin/sudo
    perm --check /usr/bin/sudo

    perm --scan /etc/ssh
    perm --scan --check /etc/ssh
    perm --json --scan --check /etc/ssh
    perm --scan --recursive /etc
    perm --scan --recursive --check --changes-only /etc

    perm --why bob read /srv/app/data.txt
    perm --why 1001 w /var/www/index.html
    perm --json --why www-data execute /usr/local/bin/tool
    perm --why alice delete /tmp/report.txt

EOF
}


error() {
    echo -e "${ERR_RED}Error:${ERR_RESET} $1" >&2
    exit 2
}


# ============================================================
# Validation
# ============================================================

validate_path() {
    local path="$1"

    [[ -e "$path" || -L "$path" ]] ||
        error "Path does not exist: $path"
}


validate_octal() {
    local value="$1"

    [[ "$value" =~ ^[0-7]{3,4}$ ]] ||
        error "Invalid permission value: $value"
}


# ============================================================
# Permission Functions
# ============================================================

# stat -c %a drops leading zeros (mode 0007 -> "7", 0070 -> "70",
# 0000 -> "0"). Always pad to 4 digits before slicing by position.
normalize_octal() {
    local o="$1"

    while [[ ${#o} -lt 4 ]]; do
        o="0$o"
    done

    printf '%s' "$o"
}


get_special_bits() {
    local octal="$1"

    octal=$(normalize_octal "$octal")

    local special="${octal:0:1}"

    local suid=0
    local sgid=0
    local sticky=0

    (( special & 4 )) && suid=1
    (( special & 2 )) && sgid=1
    (( special & 1 )) && sticky=1

    echo "$suid|$sgid|$sticky"
}


permission_detail() {
    local octal="$1"

    octal=$(normalize_octal "$octal")
    octal="${octal:1}"

    local owner="${octal:0:1}"
    local group="${octal:1:1}"
    local others="${octal:2:1}"

    local or=NO ow=NO ox=NO
    local gr=NO gw=NO gx=NO
    local tr=NO tw=NO tx=NO

    (( owner & 4 )) && or=YES
    (( owner & 2 )) && ow=YES
    (( owner & 1 )) && ox=YES

    (( group & 4 )) && gr=YES
    (( group & 2 )) && gw=YES
    (( group & 1 )) && gx=YES

    (( others & 4 )) && tr=YES
    (( others & 2 )) && tw=YES
    (( others & 1 )) && tx=YES

    echo "$or|$ow|$ox|$gr|$gw|$gx|$tr|$tw|$tx"
}


decode_permission() {
    local octal="$1"

    validate_octal "$octal"

    octal=$(normalize_octal "$octal")

    local special="${octal:0:1}"
    local owner="${octal:1:1}"
    local group="${octal:2:1}"
    local others="${octal:3:1}"

    local symbolic=""

    # Owner
    (( owner & 4 )) && symbolic+="r" || symbolic+="-"
    (( owner & 2 )) && symbolic+="w" || symbolic+="-"

    if (( owner & 1 )); then
        (( special & 4 )) && symbolic+="s" || symbolic+="x"
    else
        (( special & 4 )) && symbolic+="S" || symbolic+="-"
    fi

    # Group
    (( group & 4 )) && symbolic+="r" || symbolic+="-"
    (( group & 2 )) && symbolic+="w" || symbolic+="-"

    if (( group & 1 )); then
        (( special & 2 )) && symbolic+="s" || symbolic+="x"
    else
        (( special & 2 )) && symbolic+="S" || symbolic+="-"
    fi

    # Others
    (( others & 4 )) && symbolic+="r" || symbolic+="-"
    (( others & 2 )) && symbolic+="w" || symbolic+="-"

    if (( others & 1 )); then
        (( special & 1 )) && symbolic+="t" || symbolic+="x"
    else
        (( special & 1 )) && symbolic+="T" || symbolic+="-"
    fi

    echo "$symbolic"
}


explain_octal() {
    local octal="$1"

    validate_octal "$octal"

    octal=$(normalize_octal "$octal")

    local symbolic
    symbolic=$(decode_permission "$octal")

    local detail
    detail=$(permission_detail "$octal")

    IFS='|' read -r \
        or ow ox \
        gr gw gx \
        tr tw tx <<< "$detail"

    IFS='|' read -r suid sgid sticky <<< "$(get_special_bits "$octal")"

    echo
    echo -e "${BOLD}Permission:${RESET} $octal"
    echo -e "${BOLD}Symbolic :${RESET} -$symbolic"
    echo

    echo -e "${CYAN}Owner:${RESET}"
    printf "  Read    : %s\n" "$or"
    printf "  Write   : %s\n" "$ow"
    printf "  Execute : %s\n" "$ox"
    echo

    echo -e "${CYAN}Group:${RESET}"
    printf "  Read    : %s\n" "$gr"
    printf "  Write   : %s\n" "$gw"
    printf "  Execute : %s\n" "$gx"
    echo

    echo -e "${CYAN}Others:${RESET}"
    printf "  Read    : %s\n" "$tr"
    printf "  Write   : %s\n" "$tw"
    printf "  Execute : %s\n" "$tx"
    echo

    echo -e "${CYAN}Special Bits:${RESET}"

    [[ "$suid" == "1" ]] &&
        echo "  SUID    : ENABLED" ||
        echo "  SUID    : disabled"

    [[ "$sgid" == "1" ]] &&
        echo "  SGID    : ENABLED" ||
        echo "  SGID    : disabled"

    [[ "$sticky" == "1" ]] &&
        echo "  Sticky  : ENABLED" ||
        echo "  Sticky  : disabled"

    echo
}


# ============================================================
# Access Check
# ============================================================

check_access() {
    local path="$1"

    # For a symbolic link, [[ -r/-w/-x ]] follows the link, so the
    # result describes the TARGET, not the link itself (a link's own
    # mode bits are ignored by Linux). Say so explicitly.
    if [[ -L "$path" ]]; then
        if [[ ! -e "$path" ]]; then
            echo -e "${CYAN}Current User Access:${RESET}"
            echo "  Target cannot be resolved (dangling symlink or loop)"
            return 0
        fi
        echo -e "${CYAN}Current User Access (via target):${RESET}"
    else
        echo -e "${CYAN}Current User Access:${RESET}"
    fi

    [[ -r "$path" ]] &&
        echo "  Read    : YES" ||
        echo "  Read    : NO"

    [[ -w "$path" ]] &&
        echo "  Write   : YES" ||
        echo "  Write   : NO"

    [[ -x "$path" ]] &&
        echo "  Execute : YES" ||
        echo "  Execute : NO"
}


# ============================================================
# Security Analysis
# ============================================================

security_analysis() {
    local path="$1"

    validate_path "$path"

    # Linux ignores the permission bits of a symbolic link (always 777
    # on Linux); access is decided by the target. Mode-based findings
    # would be false positives for every symlink, so skip them.
    if [[ -L "$path" ]]; then
        echo
        echo -e "${BOLD}${MAGENTA}Security Analysis${RESET}"
        echo "-------------------------"
        echo -e "${YELLOW}[INFO]${RESET} Symbolic link: its own permission bits are ignored by Linux."
        echo -e "${YELLOW}[INFO]${RESET} Access is decided by the target; analyze the target path directly."
        return 0
    fi

    local octal
    octal=$(stat -c '%a' "$path")

    octal=$(normalize_octal "$octal")

    local special="${octal:0:1}"
    local group="${octal:2:1}"
    local others="${octal:3:1}"

    local warnings=0

    echo
    echo -e "${BOLD}${MAGENTA}Security Analysis${RESET}"
    echo "-------------------------"

    if (( others & 2 )); then
        echo -e "${RED}[WARNING]${RESET} Others have WRITE permission."
        ((warnings++))
    fi

    if (( others & 1 )); then
        echo -e "${YELLOW}[INFO]${RESET} Others have EXECUTE permission."
    fi

    if (( group & 2 )); then
        echo -e "${YELLOW}[INFO]${RESET} Group has WRITE permission."
    fi

    if (( special & 4 )); then
        echo -e "${YELLOW}[WARNING]${RESET} SUID bit is enabled."
        ((warnings++))
    fi

    if (( special & 2 )); then
        echo -e "${YELLOW}[INFO]${RESET} SGID bit is enabled."
    fi

    if (( special & 1 )); then
        echo -e "${GREEN}[INFO]${RESET} Sticky bit is enabled."
    fi

    if (( warnings == 0 )); then
        echo -e "${GREEN}No major permission security warnings detected.${RESET}"
    fi

    return 0
}


# ============================================================
# JSON Helpers
# ============================================================

json_escape() {
    local value="$1"

    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"

    # Any other control character (e.g. ESC in a file name) must be
    # written as \u00XX, otherwise the JSON is invalid.
    if [[ "$value" =~ [[:cntrl:]] ]]; then
        local out="" ch i

        for (( i = 0; i < ${#value}; i++ )); do
            ch="${value:i:1}"

            if [[ "$ch" == [[:cntrl:]] ]]; then
                printf -v ch '\\u%04x' "'$ch"
            fi

            out+="$ch"
        done

        value="$out"
    fi

    printf '%s' "$value"
}


json_bool() {
    if [[ "$1" == "1" ]]; then
        echo "true"
    else
        echo "false"
    fi
}


# ============================================================
# JSON Analyze
# ============================================================

json_analyze() {
    local path="$1"

    validate_path "$path"

    local type octal symbolic
    local owner uid group gid
    local size inode links
    local atime mtime ctime
    local target=""

    type=$(stat -c '%F' "$path")
    octal=$(stat -c '%a' "$path")
    symbolic=$(stat -c '%A' "$path")

    owner=$(stat -c '%U' "$path")
    uid=$(stat -c '%u' "$path")

    group=$(stat -c '%G' "$path")
    gid=$(stat -c '%g' "$path")

    size=$(stat -c '%s' "$path")
    inode=$(stat -c '%i' "$path")
    links=$(stat -c '%h' "$path")

    atime=$(stat -c '%x' "$path")
    mtime=$(stat -c '%y' "$path")
    ctime=$(stat -c '%z' "$path")

    if [[ -L "$path" ]]; then
        target=$(readlink "$path")
    fi

    local numeric="$octal"

    numeric=$(normalize_octal "$numeric")

    IFS='|' read -r suid sgid sticky <<< "$(get_special_bits "$numeric")"

    echo "{"
    echo "  \"path\": \"$(json_escape "$path")\","
    echo "  \"type\": \"$(json_escape "$type")\","

    echo "  \"permissions\": {"
    echo "    \"octal\": \"$octal\","
    echo "    \"symbolic\": \"$(json_escape "$symbolic")\""
    echo "  },"

    echo "  \"ownership\": {"
    echo "    \"owner\": \"$(json_escape "$owner")\","
    echo "    \"uid\": $uid,"
    echo "    \"group\": \"$(json_escape "$group")\","
    echo "    \"gid\": $gid"
    echo "  },"

    echo "  \"metadata\": {"
    echo "    \"size\": $size,"
    echo "    \"inode\": $inode,"
    echo "    \"hard_links\": $links,"
    echo "    \"access_time\": \"$(json_escape "$atime")\","
    echo "    \"modify_time\": \"$(json_escape "$mtime")\","
    echo "    \"change_time\": \"$(json_escape "$ctime")\""
    echo "  },"

    echo "  \"special_bits\": {"
    echo "    \"suid\": $(json_bool "$suid"),"
    echo "    \"sgid\": $(json_bool "$sgid"),"
    echo "    \"sticky\": $(json_bool "$sticky")"
    echo -n "  }"

    if [[ -n "$target" ]]; then
        echo ","
        echo "  \"symlink_target\": \"$(json_escape "$target")\""
    else
        echo
    fi

    echo "}"
}


# ============================================================
# Normal Analyze
# ============================================================

analyze() {
    local path="$1"

    validate_path "$path"

    local permissions symbolic type
    local owner uid group gid
    local size inode links
    local atime mtime ctime

    permissions=$(stat -c '%a' "$path")
    symbolic=$(stat -c '%A' "$path")
    type=$(stat -c '%F' "$path")

    owner=$(stat -c '%U' "$path")
    uid=$(stat -c '%u' "$path")

    group=$(stat -c '%G' "$path")
    gid=$(stat -c '%g' "$path")

    size=$(stat -c '%s' "$path")
    inode=$(stat -c '%i' "$path")
    links=$(stat -c '%h' "$path")

    atime=$(stat -c '%x' "$path")
    mtime=$(stat -c '%y' "$path")
    ctime=$(stat -c '%z' "$path")

    echo
    echo -e "${BOLD}${BLUE}Permission Analysis${RESET}"
    echo "================================"

    echo -e "${BOLD}Path:${RESET} $path"
    echo -e "${BOLD}Type:${RESET} $type"
    echo -e "${BOLD}Size:${RESET} $size bytes"
    echo -e "${BOLD}Inode:${RESET} $inode"
    echo -e "${BOLD}Hard Links:${RESET} $links"
    echo

    echo -e "${CYAN}Permissions${RESET}"
    echo "  Symbolic : $symbolic"
    echo "  Octal    : $permissions"
    echo

    echo -e "${CYAN}Ownership${RESET}"
    echo "  Owner : $owner (UID $uid)"
    echo "  Group : $group (GID $gid)"
    echo

    echo -e "${CYAN}Timestamps${RESET}"
    echo "  Access : $atime"
    echo "  Modify : $mtime"
    echo "  Change : $ctime"

    if [[ -L "$path" ]]; then
        echo
        echo -e "${CYAN}Symlink${RESET}"
        echo "  Target : $(readlink "$path")"
    fi

    local numeric="$permissions"

    numeric=$(normalize_octal "$numeric")

    IFS='|' read -r suid sgid sticky <<< "$(get_special_bits "$numeric")"

    echo
    echo -e "${CYAN}Special Bits${RESET}"

    [[ "$suid" == "1" ]] &&
        echo "  SUID   : ENABLED" ||
        echo "  SUID   : disabled"

    [[ "$sgid" == "1" ]] &&
        echo "  SGID   : ENABLED" ||
        echo "  SGID   : disabled"

    [[ "$sticky" == "1" ]] &&
        echo "  Sticky : ENABLED" ||
        echo "  Sticky : disabled"

    echo

    check_access "$path"

    security_analysis "$path"

    echo
}


# ============================================================
# Report
# ============================================================

generate_report() {
    local path="$1"

    validate_path "$path"

    local permissions symbolic type
    local owner uid group gid
    local size inode links
    local target=""

    permissions=$(stat -c '%a' "$path")
    symbolic=$(stat -c '%A' "$path")
    type=$(stat -c '%F' "$path")

    owner=$(stat -c '%U' "$path")
    uid=$(stat -c '%u' "$path")

    group=$(stat -c '%G' "$path")
    gid=$(stat -c '%g' "$path")

    size=$(stat -c '%s' "$path")
    inode=$(stat -c '%i' "$path")
    links=$(stat -c '%h' "$path")

    if [[ -L "$path" ]]; then
        target=$(readlink "$path")
    fi

    local numeric="$permissions"

    numeric=$(normalize_octal "$numeric")

    IFS='|' read -r suid sgid sticky <<< "$(get_special_bits "$numeric")"

    echo
    echo -e "${BOLD}${BLUE}perm Security Report${RESET}"
    echo "========================================"

    echo
    echo "Target"
    echo "------"
    echo "Path       : $path"
    echo "Type       : $type"
    echo "Size       : $size bytes"
    echo "Inode      : $inode"
    echo "Hard Links : $links"

    if [[ -n "$target" ]]; then
        echo "Symlink    : $target"
    fi

    echo
    echo "Permissions"
    echo "-----------"
    echo "Symbolic   : $symbolic"
    echo "Octal      : $permissions"

    echo
    echo "Ownership"
    echo "---------"
    echo "Owner      : $owner"
    echo "UID        : $uid"
    echo "Group      : $group"
    echo "GID        : $gid"

    echo
    echo "Special Bits"
    echo "------------"

    [[ "$suid" == "1" ]] &&
        echo "SUID       : ENABLED" ||
        echo "SUID       : disabled"

    [[ "$sgid" == "1" ]] &&
        echo "SGID       : ENABLED" ||
        echo "SGID       : disabled"

    [[ "$sticky" == "1" ]] &&
        echo "Sticky     : ENABLED" ||
        echo "Sticky     : disabled"

    echo
    if [[ -L "$path" && -e "$path" ]]; then
        echo "Current User Access (via target)"
        echo "--------------------------------"
    else
        echo "Current User Access"
        echo "-------------------"
    fi

    if [[ -L "$path" && ! -e "$path" ]]; then
        echo "Target cannot be resolved (dangling symlink or loop)"
    else
        [[ -r "$path" ]] &&
            echo "Read       : YES" ||
            echo "Read       : NO"

        [[ -w "$path" ]] &&
            echo "Write      : YES" ||
            echo "Write      : NO"

        [[ -x "$path" ]] &&
            echo "Execute    : YES" ||
            echo "Execute    : NO"
    fi

    echo
    echo "Security Findings"
    echo "------------------"

    local findings=0
    local others="${numeric:3:1}"

    if [[ -L "$path" ]]; then
        echo "[INFO] Symbolic link: its own permission bits are ignored by Linux."
        echo "[INFO] Access is decided by the target; analyze the target path directly."
        echo
        return 0
    fi

    if (( others & 2 )); then
        echo "[WARNING] Others have write permission."
        ((findings++))
    fi

    if (( suid )); then
        echo "[WARNING] SUID is enabled."
        ((findings++))
    fi

    if (( sgid )); then
        echo "[INFO] SGID is enabled."
    fi

    if (( sticky )); then
        echo "[INFO] Sticky bit is enabled."
    fi

    if (( findings == 0 )); then
        echo "[OK] No major security findings detected."
    fi

    echo
}


# ============================================================
# Compare - Permissions
# ============================================================

compare_permissions() {
    local file1="$1"
    local file2="$2"
    local diff=0

    local octal1 octal2

    octal1=$(stat -c '%a' "$file1")
    octal2=$(stat -c '%a' "$file2")

    IFS='|' read -r \
        o1r o1w o1x \
        g1r g1w g1x \
        t1r t1w t1x <<< "$(permission_detail "$octal1")"

    IFS='|' read -r \
        o2r o2w o2x \
        g2r g2w g2x \
        t2r t2w t2x <<< "$(permission_detail "$octal2")"

    echo "Permission differences:"

    if [[ "$o1r" != "$o2r" ]]; then
        echo "  Owner Read     : $o1r -> $o2r"
        diff=1
    fi

    if [[ "$o1w" != "$o2w" ]]; then
        echo "  Owner Write    : $o1w -> $o2w"
        diff=1
    fi

    if [[ "$o1x" != "$o2x" ]]; then
        echo "  Owner Execute  : $o1x -> $o2x"
        diff=1
    fi

    if [[ "$g1r" != "$g2r" ]]; then
        echo "  Group Read     : $g1r -> $g2r"
        diff=1
    fi

    if [[ "$g1w" != "$g2w" ]]; then
        echo "  Group Write    : $g1w -> $g2w"
        diff=1
    fi

    if [[ "$g1x" != "$g2x" ]]; then
        echo "  Group Execute  : $g1x -> $g2x"
        diff=1
    fi

    if [[ "$t1r" != "$t2r" ]]; then
        echo "  Others Read    : $t1r -> $t2r"
        diff=1
    fi

    if [[ "$t1w" != "$t2w" ]]; then
        echo "  Others Write   : $t1w -> $t2w"
        diff=1
    fi

    if [[ "$t1x" != "$t2x" ]]; then
        echo "  Others Execute : $t1x -> $t2x"
        diff=1
    fi

    if (( diff == 0 )); then
        echo "  No permission differences."
    fi

    return "$diff"
}


# ============================================================
# Compare - Ownership
# ============================================================

compare_ownership() {
    local file1="$1"
    local file2="$2"
    local diff=0

    local owner1 uid1 group1 gid1
    local owner2 uid2 group2 gid2

    owner1=$(stat -c '%U' "$file1")
    owner2=$(stat -c '%U' "$file2")

    uid1=$(stat -c '%u' "$file1")
    uid2=$(stat -c '%u' "$file2")

    group1=$(stat -c '%G' "$file1")
    group2=$(stat -c '%G' "$file2")

    gid1=$(stat -c '%g' "$file1")
    gid2=$(stat -c '%g' "$file2")

    echo "Ownership differences:"

    if [[ "$owner1" != "$owner2" || "$uid1" != "$uid2" ]]; then
        echo "  Owner : $owner1 ($uid1) -> $owner2 ($uid2)"
        diff=1
    fi

    if [[ "$group1" != "$group2" || "$gid1" != "$gid2" ]]; then
        echo "  Group : $group1 ($gid1) -> $group2 ($gid2)"
        diff=1
    fi

    if (( diff == 0 )); then
        echo "  No ownership differences."
    fi

    return "$diff"
}


# ============================================================
# Compare - Special Bits
# ============================================================

compare_special() {
    local file1="$1"
    local file2="$2"

    local octal1 octal2
    local diff=0

    octal1=$(stat -c '%a' "$file1")
    octal2=$(stat -c '%a' "$file2")

    IFS='|' read -r s1 g1 t1 <<< "$(get_special_bits "$octal1")"
    IFS='|' read -r s2 g2 t2 <<< "$(get_special_bits "$octal2")"

    echo "Special Bits:"

    printf "  %-18s %-20s %s\n" \
        "SUID" \
        "$([[ "$s1" == "1" ]] && echo YES || echo NO)" \
        "$([[ "$s2" == "1" ]] && echo YES || echo NO)"

    printf "  %-18s %-20s %s\n" \
        "SGID" \
        "$([[ "$g1" == "1" ]] && echo YES || echo NO)" \
        "$([[ "$g2" == "1" ]] && echo YES || echo NO)"

    printf "  %-18s %-20s %s\n" \
        "Sticky" \
        "$([[ "$t1" == "1" ]] && echo YES || echo NO)" \
        "$([[ "$t2" == "1" ]] && echo YES || echo NO)"

    if [[ "$s1" != "$s2" ]]; then
        echo "  SUID   : $([[ "$s1" == "1" ]] && echo YES || echo NO) -> $([[ "$s2" == "1" ]] && echo YES || echo NO)"
        diff=1
    fi

    if [[ "$g1" != "$g2" ]]; then
        echo "  SGID   : $([[ "$g1" == "1" ]] && echo YES || echo NO) -> $([[ "$g2" == "1" ]] && echo YES || echo NO)"
        diff=1
    fi

    if [[ "$t1" != "$t2" ]]; then
        echo "  Sticky : $([[ "$t1" == "1" ]] && echo YES || echo NO) -> $([[ "$t2" == "1" ]] && echo YES || echo NO)"
        diff=1
    fi

    if (( diff == 0 )); then
        echo "  No special-bit differences."
    else
        echo "  Special-bit differences detected."
    fi

    return "$diff"
}


# ============================================================
# JSON Compare
# ============================================================

json_compare() {
    local file1="$1"
    local file2="$2"

    validate_path "$file1"
    validate_path "$file2"

    local p1 p2
    local o1 o2 uid1 uid2
    local g1 g2 gid1 gid2
    local s1 s2 sg1 sg2 st1 st2

    p1=$(stat -c '%a' "$file1")
    p2=$(stat -c '%a' "$file2")

    o1=$(stat -c '%U' "$file1")
    o2=$(stat -c '%U' "$file2")

    uid1=$(stat -c '%u' "$file1")
    uid2=$(stat -c '%u' "$file2")

    g1=$(stat -c '%G' "$file1")
    g2=$(stat -c '%G' "$file2")

    gid1=$(stat -c '%g' "$file1")
    gid2=$(stat -c '%g' "$file2")

    IFS='|' read -r s1 sg1 st1 <<< "$(get_special_bits "$p1")"
    IFS='|' read -r s2 sg2 st2 <<< "$(get_special_bits "$p2")"

    local permission_diff=false
    local ownership_diff=false
    local special_diff=false

    # Only the rwx part (last three digits) is compared here.
    # Special bits (SUID/SGID/Sticky) are a separate category and are
    # reported under "special_bits", exactly like the text-mode
    # --permissions and --special filters.
    local n1 n2
    n1=$(normalize_octal "$p1")
    n2=$(normalize_octal "$p2")

    [[ "${n1:1}" != "${n2:1}" ]] &&
        permission_diff=true

    if [[ "$o1" != "$o2" ||
          "$uid1" != "$uid2" ||
          "$g1" != "$g2" ||
          "$gid1" != "$gid2" ]]; then
        ownership_diff=true
    fi

    if [[ "$s1" != "$s2" ||
          "$sg1" != "$sg2" ||
          "$st1" != "$st2" ]]; then
        special_diff=true
    fi

    echo "{"
    echo "  \"file1\": \"$(json_escape "$file1")\","
    echo "  \"file2\": \"$(json_escape "$file2")\","

    echo "  \"permissions\": {"
    echo "    \"file1\": \"$p1\","
    echo "    \"file2\": \"$p2\","
    echo "    \"different\": $permission_diff"
    echo "  },"

    echo "  \"ownership\": {"

    echo "    \"file1\": {"
    echo "      \"owner\": \"$(json_escape "$o1")\","
    echo "      \"uid\": $uid1,"
    echo "      \"group\": \"$(json_escape "$g1")\","
    echo "      \"gid\": $gid1"
    echo "    },"

    echo "    \"file2\": {"
    echo "      \"owner\": \"$(json_escape "$o2")\","
    echo "      \"uid\": $uid2,"
    echo "      \"group\": \"$(json_escape "$g2")\","
    echo "      \"gid\": $gid2"
    echo "    },"

    echo "    \"different\": $ownership_diff"
    echo "  },"

    echo "  \"special_bits\": {"

    echo "    \"file1\": {"
    echo "      \"suid\": $(json_bool "$s1"),"
    echo "      \"sgid\": $(json_bool "$sg1"),"
    echo "      \"sticky\": $(json_bool "$st1")"
    echo "    },"

    echo "    \"file2\": {"
    echo "      \"suid\": $(json_bool "$s2"),"
    echo "      \"sgid\": $(json_bool "$sg2"),"
    echo "      \"sticky\": $(json_bool "$st2")"
    echo "    },"

    echo "    \"different\": $special_diff"
    echo "  }"

    echo "}"

    if [[ "$permission_diff" == true ||
          "$ownership_diff" == true ||
          "$special_diff" == true ]]; then
        return 1
    fi

    return 0
}


# ============================================================
# Compare Files
# ============================================================

compare_files() {
    local file1="$1"
    local file2="$2"

    local permissions_only="$3"
    local ownership_only="$4"
    local special_only="$5"
    local diff_only="$6"

    validate_path "$file1"
    validate_path "$file2"

    local any_diff=0

    # --------------------------------------------------------
    # Filtered comparisons
    # --------------------------------------------------------

    if (( permissions_only )); then

        compare_permissions "$file1" "$file2"
        [[ $? -eq 1 ]] && any_diff=1

        echo
        echo "Result:"

        if (( any_diff )); then
            echo -e "  ${YELLOW}Differences detected.${RESET}"
            return 1
        else
            echo -e "  ${GREEN}No differences detected.${RESET}"
            return 0
        fi
    fi


    if (( ownership_only )); then

        compare_ownership "$file1" "$file2"
        [[ $? -eq 1 ]] && any_diff=1

        echo
        echo "Result:"

        if (( any_diff )); then
            echo -e "  ${YELLOW}Differences detected.${RESET}"
            return 1
        else
            echo -e "  ${GREEN}No differences detected.${RESET}"
            return 0
        fi
    fi


    if (( special_only )); then

        compare_special "$file1" "$file2"
        [[ $? -eq 1 ]] && any_diff=1

        echo
        echo "Result:"

        if (( any_diff )); then
            echo -e "  ${YELLOW}Differences detected.${RESET}"
            return 1
        else
            echo -e "  ${GREEN}No differences detected.${RESET}"
            return 0
        fi
    fi


    # --------------------------------------------------------
    # General comparison
    # --------------------------------------------------------

    if (( !diff_only )); then
        echo
        echo -e "${BOLD}${BLUE}File Comparison${RESET}"
        echo "================================"
        echo "File 1 : $file1"
        echo "File 2 : $file2"
        echo
    fi


    local type1 type2
    local size1 size2
    local inode1 inode2
    local links1 links2

    type1=$(stat -c '%F' "$file1")
    type2=$(stat -c '%F' "$file2")

    size1=$(stat -c '%s' "$file1")
    size2=$(stat -c '%s' "$file2")

    inode1=$(stat -c '%i' "$file1")
    inode2=$(stat -c '%i' "$file2")

    links1=$(stat -c '%h' "$file1")
    links2=$(stat -c '%h' "$file2")


    if (( diff_only )); then

        [[ "$type1" != "$type2" ]] && {
            echo "Type        : $type1 -> $type2"
            any_diff=1
        }

        [[ "$size1" != "$size2" ]] && {
            echo "Size        : $size1 -> $size2"
            any_diff=1
        }

        [[ "$inode1" != "$inode2" ]] && {
            echo "Inode       : $inode1 -> $inode2"
            any_diff=1
        }

        [[ "$links1" != "$links2" ]] && {
            echo "Hard Links  : $links1 -> $links2"
            any_diff=1
        }

    else

        echo "General Information:"
        echo "  Type        : $type1 -> $type2"
        echo "  Size        : $size1 -> $size2"
        echo "  Inode       : $inode1 -> $inode2"
        echo "  Hard Links  : $links1 -> $links2"

        if [[ "$type1" == "$type2" &&
              "$size1" == "$size2" &&
              "$inode1" == "$inode2" &&
              "$links1" == "$links2" ]]; then

            echo "  General information is identical."

        else
            any_diff=1
        fi

        echo
    fi


    compare_permissions "$file1" "$file2"
    [[ $? -eq 1 ]] && any_diff=1

    if (( !diff_only )); then
        echo
    fi

    compare_ownership "$file1" "$file2"
    [[ $? -eq 1 ]] && any_diff=1

    if (( !diff_only )); then
        echo
    fi

    compare_special "$file1" "$file2"
    [[ $? -eq 1 ]] && any_diff=1


    echo
    echo "Result:"

    if (( any_diff )); then
        echo -e "  ${YELLOW}Differences detected.${RESET}"
        return 1
    else
        echo -e "  ${GREEN}Files are identical in analyzed attributes.${RESET}"
        return 0
    fi
}


# ============================================================
# Baseline / Change Detection (2.4) and Management (2.5)
# ============================================================
#
# A baseline is a small text file (key=value, one per line) holding the
# security-relevant state of ONE target at a point in time.
#
# It is never executed or sourced: values are read line by line, only
# whitelisted keys are accepted, and every value is validated.
#
# Storage:  ${XDG_DATA_HOME:-$HOME/.local/share}/perm/baselines/<sha256 of absolute path>.baseline
#
# Exit codes for --check:  0 = no change, 1 = change detected, 2 = error

BASELINE_FORMAT="1"

declare -A BL=()      # loaded baseline values
BASELINE_DIR=""
BASELINE_FILE=""


strip_trailing_slashes() {
    local p="$1"

    while [[ "$p" != "/" && "$p" == */ ]]; do
        p="${p%/}"
    done

    printf '%s' "$p"
}


# Absolute path of the target itself (the last component is NOT resolved,
# so a symlink is baselined as a symlink, just like stat does).
# Works even if the target no longer exists.
abs_path() {
    local p="$1"
    local dir base dir_abs

    if [[ "$p" == "/" ]]; then
        printf '/'
        return 0
    fi

    if [[ -d "$p" && ! -L "$p" ]]; then
        if dir_abs=$(cd -P -- "$p" 2>/dev/null && pwd -P); then
            printf '%s' "$dir_abs"
            return 0
        fi
    fi

    dir=$(dirname -- "$p")
    base=$(basename -- "$p")

    if dir_abs=$(cd -P -- "$dir" 2>/dev/null && pwd -P); then
        if [[ "$dir_abs" == "/" ]]; then
            printf '/%s' "$base"
        else
            printf '%s/%s' "$dir_abs" "$base"
        fi
    else
        # Parent directory is gone as well: lexical fallback.
        if [[ "$p" == /* ]]; then
            printf '%s' "$p"
        else
            printf '%s/%s' "$PWD" "$p"
        fi
    fi
}


# Sets BASELINE_DIR.
# (Called directly, not inside $(...), so error() can exit the script.)
resolve_baseline_dir() {
    local base

    if [[ -n "${XDG_DATA_HOME:-}" && "$XDG_DATA_HOME" == /* ]]; then
        base="$XDG_DATA_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        base="$HOME/.local/share"
    else
        error "Cannot determine baseline directory (HOME is not set)"
    fi

    BASELINE_DIR="$base/perm/baselines"
}


# Sets BASELINE_DIR and BASELINE_FILE for an absolute path.
resolve_baseline_paths() {
    local abs="$1"
    local hash

    resolve_baseline_dir

    hash=$(printf '%s' "$abs" | sha256sum 2>/dev/null)
    hash="${hash%% *}"

    [[ "$hash" =~ ^[0-9a-f]{64}$ ]] ||
        error "Cannot compute baseline key (is sha256sum available?)"

    BASELINE_FILE="$BASELINE_DIR/$hash.baseline"
}


# 6755 -> 6755, 0755 -> 755  (matches what people expect to read)
display_octal() {
    local o="$1"

    if [[ "${o:0:1}" == "0" ]]; then
        printf '%s' "${o:1}"
    else
        printf '%s' "$o"
    fi
}


flag_word() {
    [[ "$1" == "1" ]] && printf 'ENABLED' || printf 'DISABLED'
}


# Reads the CURRENT state of a path into CUR_* globals.
# Only "regular file" and "regular empty file" support content hashing.
is_regular_file_type() {
    [[ "$1" == "regular file" || "$1" == "regular empty file" ]]
}


hash_content() {
    local path="$1"
    local out

    out=$(sha256sum -- "$path" 2>/dev/null) || return 1
    printf '%s' "${out%% *}"
}


# Sets CUR_* for a path. Content hash (CUR_SHA256) is only computed when
# want_hash=1 is passed AND the target is a regular file; otherwise
# CUR_SHA256 is left unset, so callers must check is_regular_file_type
# before relying on it.
collect_current() {
    local path="$1"
    local want_hash="${2:-0}"
    local raw out sp

    # One stat call for every field (it used to be eight). 0x1f (unit
    # separator) splits the fields: it cannot occur in a file type or in a
    # user/group name, unlike a space or '|'.
    out=$(stat --printf='%F\x1f%a\x1f%U\x1f%u\x1f%G\x1f%g\x1f%i\x1f%s' \
          -- "$path") || return 1

    IFS=$'\x1f' read -r CUR_TYPE raw CUR_OWNER CUR_UID \
        CUR_GROUP CUR_GID CUR_INODE CUR_SIZE <<< "$out"

    # stat -c %a drops leading zeros: pad to 4 digits (see normalize_octal).
    CUR_OCTAL="$raw"
    while (( ${#CUR_OCTAL} < 4 )); do
        CUR_OCTAL="0$CUR_OCTAL"
    done

    # Special bits (see get_special_bits), without a subshell.
    sp="${CUR_OCTAL:0:1}"
    CUR_SUID=0 CUR_SGID=0 CUR_STICKY=0
    (( sp & 4 )) && CUR_SUID=1
    (( sp & 2 )) && CUR_SGID=1
    (( sp & 1 )) && CUR_STICKY=1

    CUR_SHA256=""

    if (( want_hash )) && is_regular_file_type "$CUR_TYPE"; then
        CUR_SHA256=$(hash_content "$path") || return 1
    fi

    return 0
}


BL_ERROR=""

# Reads and validates a baseline file into the BL array.
# Non-fatal: returns 0, or returns 1 and sets BL_ERROR.
# (--list must survive damaged baselines; --check must not.)
read_baseline() {
    local file="$1"
    local key value k

    BL=()
    BL_ERROR=""

    if [[ ! -r "$file" ]]; then
        BL_ERROR="Cannot read baseline file: $file"
        return 1
    fi

    while IFS='=' read -r key value || [[ -n "$key" ]]; do
        case "$key" in
            baseline_format|created|path|type|octal|owner|uid|group|gid|\
suid|sgid|sticky|inode|size|sha256)
                BL["$key"]="$value"
                ;;
        esac
    done < "$file"

    for k in baseline_format created path type octal owner uid group gid \
             suid sgid sticky inode size; do
        if [[ -z "${BL[$k]+x}" || -z "${BL[$k]}" ]]; then
            BL_ERROR="Baseline file is corrupted (missing '$k'): $file"
            return 1
        fi
    done

    if [[ "${BL[baseline_format]}" != "$BASELINE_FORMAT" ]]; then
        BL_ERROR="Unsupported baseline format '${BL[baseline_format]}': $file"
        return 1
    fi

    if [[ ! "${BL[octal]}" =~ ^[0-7]{4}$ ]]; then
        BL_ERROR="Baseline file is corrupted (invalid octal): $file"
        return 1
    fi

    for k in uid gid inode size; do
        if [[ ! "${BL[$k]}" =~ ^[0-9]+$ ]]; then
            BL_ERROR="Baseline file is corrupted (invalid $k): $file"
            return 1
        fi
    done

    for k in suid sgid sticky; do
        if [[ ! "${BL[$k]}" =~ ^[01]$ ]]; then
            BL_ERROR="Baseline file is corrupted (invalid $k): $file"
            return 1
        fi
    done

    # sha256 is optional: baselines created before 2.5.1, or without
    # --strict, simply do not have it.
    if [[ -n "${BL[sha256]+x}" ]]; then
        if [[ ! "${BL[sha256]}" =~ ^[0-9a-f]{64}$ ]]; then
            BL_ERROR="Baseline file is corrupted (invalid sha256): $file"
            return 1
        fi
    fi

    return 0
}


# Fatal wrapper used by --check.
load_baseline() {
    read_baseline "$1" || error "$BL_ERROR"
}


# ------------------------------------------------------------
# --baseline
# ------------------------------------------------------------

# Core of --baseline.
#
# Never exits and never prints: returns 0, or returns 1 with the message in
# CORE_ERR. Sets BL_EXISTED (1 if an existing baseline was replaced) and
# the CUR_* globals. This is the same pattern as read_baseline (non-fatal)
# / load_baseline (fatal wrapper), and it lets --scan call it in a plain
# loop, without a subshell per file.
#
# Precondition: BASELINE_DIR and BASELINE_FILE are already resolved for ABS
# (resolve_baseline_paths). PATH is the path as the caller wants it read.
baseline_store() {
    local path="$1"
    local abs="$2"
    local force="$3"
    local strict="$4"

    BL_EXISTED=0
    CORE_ERR=""

    if [[ -e "$BASELINE_FILE" ]]; then
        if (( ! force )); then
            CORE_ERR="Baseline already exists for $abs (use --force to overwrite)"
            return 1
        fi

        BL_EXISTED=1

        # Do not silently drop content tracking on an update.
        if (( ! strict )); then
            if read_baseline "$BASELINE_FILE" && [[ -n "${BL[sha256]+x}" ]]; then
                local q
                printf -v q '%q' "$path"
                CORE_ERR="Baseline for $abs tracks content (--strict). To update it use: perm --baseline --strict --force $q"$'\n'"       To drop content tracking instead: perm --remove $q, then perm --baseline $q"
                return 1
            fi
        fi
    fi

    if (( strict )); then
        local t
        t=$(stat -c '%F' "$path" 2>/dev/null) || {
            CORE_ERR="Cannot read attributes of: $path"
            return 1
        }

        is_regular_file_type "$t" || {
            CORE_ERR="--strict only supports regular files (target is: $t)"
            return 1
        }
    fi

    if ! collect_current "$path" "$strict"; then
        if (( strict )); then
            CORE_ERR="Cannot read content of: $path"
        else
            CORE_ERR="Cannot read attributes of: $path"
        fi
        return 1
    fi

    if [[ ! -d "$BASELINE_DIR" ]]; then
        (umask 077; mkdir -p "$BASELINE_DIR") 2>/dev/null || {
            CORE_ERR="Cannot create baseline directory: $BASELINE_DIR"
            return 1
        }
    fi

    local tmp created
    tmp=$(mktemp "$BASELINE_DIR/.tmp.XXXXXX" 2>/dev/null) || {
        CORE_ERR="Cannot write to baseline directory: $BASELINE_DIR"
        return 1
    }

    printf -v created '%(%Y-%m-%d %H:%M:%S %z)T' -1

    {
        printf 'baseline_format=%s\n' "$BASELINE_FORMAT"
        printf 'perm_version=%s\n'    "$VERSION"
        printf 'created=%s\n'         "$created"
        printf 'path=%s\n'            "$abs"
        printf 'type=%s\n'            "$CUR_TYPE"
        printf 'octal=%s\n'           "$CUR_OCTAL"
        printf 'owner=%s\n'           "$CUR_OWNER"
        printf 'uid=%s\n'             "$CUR_UID"
        printf 'group=%s\n'           "$CUR_GROUP"
        printf 'gid=%s\n'             "$CUR_GID"
        printf 'suid=%s\n'            "$CUR_SUID"
        printf 'sgid=%s\n'            "$CUR_SGID"
        printf 'sticky=%s\n'          "$CUR_STICKY"
        printf 'inode=%s\n'           "$CUR_INODE"
        printf 'size=%s\n'            "$CUR_SIZE"
        if (( strict )); then
            printf 'sha256=%s\n' "$CUR_SHA256"
        fi
        true
    } > "$tmp" || {
        rm -f -- "$tmp"
        CORE_ERR="Cannot write baseline file"
        return 1
    }

    mv -f -- "$tmp" "$BASELINE_FILE" || {
        rm -f -- "$tmp"
        CORE_ERR="Cannot save baseline file"
        return 1
    }

    return 0
}


baseline_create() {
    local path="$1"
    local force="$2"
    local strict="$3"

    validate_path "$path"

    path=$(strip_trailing_slashes "$path")

    local abs
    abs=$(abs_path "$path")

    [[ "$abs" != *$'\n'* ]] ||
        error "Paths containing newlines are not supported for baselines"

    resolve_baseline_paths "$abs"

    baseline_store "$path" "$abs" "$force" "$strict" ||
        error "$CORE_ERR"

    local existed="$BL_EXISTED"

    local symbolic
    symbolic=$(stat -c '%A' "$path")

    echo
    echo -e "${BOLD}${BLUE}perm Baseline${RESET}"
    echo "================================"
    echo "Target      : $path"
    echo "Absolute    : $abs"
    echo "Type        : $CUR_TYPE"
    echo "Permissions : $(display_octal "$CUR_OCTAL") ($symbolic)"
    echo "Owner       : $CUR_OWNER (UID $CUR_UID)"
    echo "Group       : $CUR_GROUP (GID $CUR_GID)"
    echo "SUID        : $(flag_word "$CUR_SUID")"
    echo "SGID        : $(flag_word "$CUR_SGID")"
    echo "Sticky      : $(flag_word "$CUR_STICKY")"

    if (( strict )); then
        echo "SHA-256     : $CUR_SHA256"
    fi

    echo "Stored in   : $BASELINE_FILE"
    echo

    if (( existed )); then
        echo -e "${GREEN}Baseline updated.${RESET}"
    else
        echo -e "${GREEN}Baseline created.${RESET}"
    fi

    echo

    return 0
}


# ------------------------------------------------------------
# --check  (shared logic)
# ------------------------------------------------------------

# Prepares everything --check needs:
#   sets CHK_PATH, CHK_ABS, BL[], CHK_EXISTS
#   and, if the target still exists, CUR_* and the D_* difference flags.
# Core of --check: compares the CURRENT state of PATH with the baseline
# that is already loaded in BL[].
#
# Never exits and never prints: returns 0, or returns 1 with the message in
# CORE_ERR. Sets CHK_EXISTS, CHANGED, the D_* difference flags, the N_*
# notes and, if the target still exists, CUR_*.
#
# Precondition: BL[] holds a valid baseline for this very path.
check_compare() {
    local path="$1"

    CORE_ERR=""

    D_PERM=0 D_OWN=0 D_SPEC=0 D_TYPE=0 N_SIZE=0 N_INODE=0
    CHANGED=0

    TRACK_CONTENT=0
    [[ -n "${BL[sha256]+x}" ]] && TRACK_CONTENT=1
    CONTENT_COMPARABLE=0
    D_CONTENT=0

    if [[ ! -e "$path" && ! -L "$path" ]]; then
        CHK_EXISTS=0
        CHANGED=1
        return 0
    fi

    CHK_EXISTS=1

    if ! collect_current "$path" "$TRACK_CONTENT"; then
        if (( TRACK_CONTENT )) && [[ -e "$path" ]]; then
            local t
            t=$(stat -c '%F' "$path" 2>/dev/null)
            if is_regular_file_type "$t"; then
                CORE_ERR="Cannot read content of: $path (permission denied?)"
                return 1
            fi
        fi
        CORE_ERR="Cannot read attributes of: $path"
        return 1
    fi

    # rwx only (last 3 digits). Special bits are a separate category.
    [[ "${BL[octal]:1}" != "${CUR_OCTAL:1}" ]] && D_PERM=1

    if [[ "${BL[owner]}" != "$CUR_OWNER" || "${BL[uid]}" != "$CUR_UID" ||
          "${BL[group]}" != "$CUR_GROUP" || "${BL[gid]}" != "$CUR_GID" ]]; then
        D_OWN=1
    fi

    if [[ "${BL[suid]}" != "$CUR_SUID" ||
          "${BL[sgid]}" != "$CUR_SGID" ||
          "${BL[sticky]}" != "$CUR_STICKY" ]]; then
        D_SPEC=1
    fi

    [[ "${BL[type]}" != "$CUR_TYPE" ]] && D_TYPE=1

    if (( TRACK_CONTENT )); then
        if is_regular_file_type "$CUR_TYPE"; then
            CONTENT_COMPARABLE=1
            [[ "${BL[sha256]}" != "$CUR_SHA256" ]] && D_CONTENT=1
        else
            CONTENT_COMPARABLE=0
        fi
    fi

    # Informational only - they never change the exit code.
    [[ "${BL[size]}"  != "$CUR_SIZE"  ]] && N_SIZE=1
    [[ "${BL[inode]}" != "$CUR_INODE" ]] && N_INODE=1

    (( D_PERM || D_OWN || D_SPEC || D_TYPE || D_CONTENT )) && CHANGED=1

    return 0
}


# Prepares everything --check needs:
#   sets CHK_PATH, CHK_ABS, BL[], CHK_EXISTS
#   and, if the target still exists, CUR_* and the D_* difference flags.
# Fatal wrapper: path handling and every error exit here; the comparison
# itself is check_compare.
check_prepare() {
    local path="$1"

    path=$(strip_trailing_slashes "$path")
    CHK_PATH="$path"
    CHK_ABS=$(abs_path "$path")

    [[ "$CHK_ABS" != *$'\n'* ]] ||
        error "Paths containing newlines are not supported for baselines"

    resolve_baseline_paths "$CHK_ABS"

    [[ -f "$BASELINE_FILE" ]] ||
        error "No baseline for $CHK_ABS (create one with: perm --baseline $(printf '%q' "$path"))"

    load_baseline "$BASELINE_FILE"

    [[ "${BL[path]}" == "$CHK_ABS" ]] ||
        error "Baseline file does not belong to this path: $BASELINE_FILE"

    check_compare "$path" ||
        error "$CORE_ERR"

    return 0
}


print_check_notes() {
    (( N_SIZE || N_INODE )) || return 0

    echo
    echo "Notes (informational, do not affect the result):"

    if (( N_INODE )); then
        echo "  [NOTE] Inode changed: ${BL[inode]} -> $CUR_INODE (the file may have been replaced)"
    fi

    if (( N_SIZE )); then
        echo "  [NOTE] Size changed: ${BL[size]} -> $CUR_SIZE bytes"
    fi
}


check_baseline() {
    local path="$1"

    check_prepare "$path"

    echo

    # ---- target deleted ----
    if (( ! CHK_EXISTS )); then
        echo -e "${BOLD}${RED}[CHANGE DETECTED]${RESET}"
        echo
        echo "Target   : $CHK_PATH"
        echo "Baseline : ${BL[created]}"
        echo
        echo "  The target no longer exists."
        echo
        return 1
    fi

    # ---- no change ----
    if (( ! CHANGED )); then
        echo -e "${BOLD}${GREEN}[OK] No changes detected.${RESET}"
        echo
        echo "Target   : $CHK_PATH"
        echo "Baseline : ${BL[created]}"

        if (( TRACK_CONTENT )); then
            echo "Content  : unchanged (SHA-256)"
        fi

        print_check_notes
        echo
        return 0
    fi

    # ---- change detected ----
    echo -e "${BOLD}${YELLOW}[CHANGE DETECTED]${RESET}"
    echo
    echo "Target   : $CHK_PATH"
    echo "Baseline : ${BL[created]}"

    if (( D_TYPE )); then
        echo
        echo "Type:"
        echo "  ${BL[type]} -> $CUR_TYPE"
    fi

    if (( D_PERM )); then
        local -a labels=("Owner Read" "Owner Write" "Owner Execute"
                         "Group Read" "Group Write" "Group Execute"
                         "Others Read" "Others Write" "Others Execute")
        local -a before after
        local i

        IFS='|' read -ra before <<< "$(permission_detail "${BL[octal]}")"
        IFS='|' read -ra after  <<< "$(permission_detail "$CUR_OCTAL")"

        echo
        echo "Permissions:"
        echo "  Octal           : ${BL[octal]:1} -> ${CUR_OCTAL:1}"

        for i in {0..8}; do
            if [[ "${before[i]}" != "${after[i]}" ]]; then
                printf '  %-15s : %s -> %s\n' \
                    "${labels[i]}" "${before[i]}" "${after[i]}"
            fi
        done
    fi

    if (( D_OWN )); then
        echo
        echo "Ownership:"

        if [[ "${BL[owner]}" != "$CUR_OWNER" || "${BL[uid]}" != "$CUR_UID" ]]; then
            echo "  Owner : ${BL[owner]} (${BL[uid]}) -> $CUR_OWNER ($CUR_UID)"
        fi

        if [[ "${BL[group]}" != "$CUR_GROUP" || "${BL[gid]}" != "$CUR_GID" ]]; then
            echo "  Group : ${BL[group]} (${BL[gid]}) -> $CUR_GROUP ($CUR_GID)"
        fi
    fi

    if (( D_SPEC )); then
        echo
        echo "Special Bits:"

        [[ "${BL[suid]}" != "$CUR_SUID" ]] &&
            echo "  SUID   : $(flag_word "${BL[suid]}") -> $(flag_word "$CUR_SUID")"

        [[ "${BL[sgid]}" != "$CUR_SGID" ]] &&
            echo "  SGID   : $(flag_word "${BL[sgid]}") -> $(flag_word "$CUR_SGID")"

        [[ "${BL[sticky]}" != "$CUR_STICKY" ]] &&
            echo "  Sticky : $(flag_word "${BL[sticky]}") -> $(flag_word "$CUR_STICKY")"
    fi

    if (( TRACK_CONTENT )); then
        echo
        echo "Content:"

        if (( ! CONTENT_COMPARABLE )); then
            echo "  Not comparable: target is no longer a regular file"
        elif (( D_CONTENT )); then
            echo "  SHA-256 : ${BL[sha256]:0:16}... -> ${CUR_SHA256:0:16}..."
        else
            echo "  unchanged"
        fi
    fi

    print_check_notes
    echo

    return 1
}


check_baseline_json() {
    local path="$1"

    check_prepare "$path"

    local changed=false
    (( CHANGED )) && changed=true

    echo "{"
    echo "  \"target\": \"$(json_escape "$CHK_PATH")\","
    echo "  \"absolute_path\": \"$(json_escape "$CHK_ABS")\","
    echo "  \"baseline_created\": \"$(json_escape "${BL[created]}")\","

    if (( ! CHK_EXISTS )); then
        echo "  \"exists\": false,"
        echo "  \"changed\": true"
        echo "}"
        return 1
    fi

    echo "  \"exists\": true,"
    echo "  \"changed\": $changed,"

    echo "  \"type\": {"
    echo "    \"baseline\": \"$(json_escape "${BL[type]}")\","
    echo "    \"current\": \"$(json_escape "$CUR_TYPE")\","
    echo "    \"different\": $(json_bool "$D_TYPE")"
    echo "  },"

    echo "  \"permissions\": {"
    echo "    \"baseline\": \"$(display_octal "${BL[octal]}")\","
    echo "    \"current\": \"$(display_octal "$CUR_OCTAL")\","
    echo "    \"different\": $(json_bool "$D_PERM")"
    echo "  },"

    echo "  \"ownership\": {"
    echo "    \"baseline\": {"
    echo "      \"owner\": \"$(json_escape "${BL[owner]}")\","
    echo "      \"uid\": ${BL[uid]},"
    echo "      \"group\": \"$(json_escape "${BL[group]}")\","
    echo "      \"gid\": ${BL[gid]}"
    echo "    },"
    echo "    \"current\": {"
    echo "      \"owner\": \"$(json_escape "$CUR_OWNER")\","
    echo "      \"uid\": $CUR_UID,"
    echo "      \"group\": \"$(json_escape "$CUR_GROUP")\","
    echo "      \"gid\": $CUR_GID"
    echo "    },"
    echo "    \"different\": $(json_bool "$D_OWN")"
    echo "  },"

    echo "  \"special_bits\": {"
    echo "    \"baseline\": {"
    echo "      \"suid\": $(json_bool "${BL[suid]}"),"
    echo "      \"sgid\": $(json_bool "${BL[sgid]}"),"
    echo "      \"sticky\": $(json_bool "${BL[sticky]}")"
    echo "    },"
    echo "    \"current\": {"
    echo "      \"suid\": $(json_bool "$CUR_SUID"),"
    echo "      \"sgid\": $(json_bool "$CUR_SGID"),"
    echo "      \"sticky\": $(json_bool "$CUR_STICKY")"
    echo "    },"
    echo "    \"different\": $(json_bool "$D_SPEC")"
    echo "  },"

    echo "  \"content\": {"
    echo "    \"tracked\": $(json_bool "$TRACK_CONTENT"),"
    if (( TRACK_CONTENT )); then
        echo "    \"comparable\": $(json_bool "$CONTENT_COMPARABLE"),"
        echo "    \"baseline\": \"$(json_escape "${BL[sha256]}")\","
        if (( CONTENT_COMPARABLE )); then
            echo "    \"current\": \"$(json_escape "$CUR_SHA256")\","
            echo "    \"different\": $(json_bool "$D_CONTENT")"
        else
            echo "    \"current\": null,"
            echo "    \"different\": false"
        fi
    else
        echo "    \"comparable\": false,"
        echo "    \"baseline\": null,"
        echo "    \"current\": null,"
        echo "    \"different\": false"
    fi
    echo "  },"

    echo "  \"notes\": {"
    echo "    \"size\": {"
    echo "      \"baseline\": ${BL[size]},"
    echo "      \"current\": $CUR_SIZE,"
    echo "      \"different\": $(json_bool "$N_SIZE")"
    echo "    },"
    echo "    \"inode\": {"
    echo "      \"baseline\": ${BL[inode]},"
    echo "      \"current\": $CUR_INODE,"
    echo "      \"different\": $(json_bool "$N_INODE")"
    echo "    }"
    echo "  }"
    echo "}"

    (( CHANGED )) && return 1

    return 0
}


# True if baseline file F is stored under the key of its own path
# (<sha256 of the path>.baseline), i.e. it was not renamed or copied.
baseline_name_matches() {
    local f="$1"
    local path="$2"
    local hash

    hash=$(printf '%s' "$path" | sha256sum 2>/dev/null)
    hash="${hash%% *}"

    [[ "${f##*/}" == "$hash.baseline" ]]
}


# ------------------------------------------------------------
# --list
# ------------------------------------------------------------

declare -A LS_CREATED=()
declare -A LS_STATUS=()
declare -A LS_FILE=()
declare -A LS_ERROR=()
declare -A LS_CONTENT=()

# Fills LS_* arrays. Key = absolute target path for valid baselines,
# "~<file>" for damaged ones (sorts after every absolute path).
collect_baselines() {
    local f path key

    LS_CREATED=()
    LS_STATUS=()
    LS_FILE=()
    LS_ERROR=()
    LS_CONTENT=()

    resolve_baseline_dir

    [[ -d "$BASELINE_DIR" ]] || return 0

    while IFS= read -r -d '' f; do

        if ! read_baseline "$f"; then
            key="~$f"
            LS_STATUS["$key"]="invalid"
            LS_ERROR["$key"]="${BL_ERROR%": $f"}"
            LS_FILE["$key"]="$f"
            continue
        fi

        path="${BL[path]}"

        if ! baseline_name_matches "$f" "$path"; then
            key="~$f"
            LS_STATUS["$key"]="invalid"
            LS_ERROR["$key"]="File name does not match the stored path ($path)"
            LS_FILE["$key"]="$f"
            continue
        fi

        LS_CREATED["$path"]="${BL[created]}"
        LS_FILE["$path"]="$f"
        if [[ -n "${BL[sha256]+x}" ]]; then
            LS_CONTENT["$path"]=1
        else
            LS_CONTENT["$path"]=0
        fi

        if [[ -e "$path" || -L "$path" ]]; then
            LS_STATUS["$path"]="exists"
        else
            LS_STATUS["$path"]="missing"
        fi

    done < <(find "$BASELINE_DIR" -maxdepth 1 -type f -name '*.baseline' -print0 2>/dev/null)
}


list_baselines() {
    collect_baselines

    local total=${#LS_STATUS[@]}
    local n_exists=0 n_missing=0 n_invalid=0
    local k st col

    echo
    echo -e "${BOLD}${BLUE}perm Baselines${RESET}"
    echo "================================"
    echo "Store : $BASELINE_DIR"
    echo

    if (( total == 0 )); then
        echo "No baselines stored."
        echo
        return 0
    fi

    printf '%-8s %-8s %-26s %s\n' "STATUS" "CONTENT" "CREATED" "TARGET"

    while IFS= read -r -d '' k; do
        st="${LS_STATUS[$k]}"

        case "$st" in
            exists)  col="$GREEN";  ((n_exists++))  ;;
            missing) col="$YELLOW"; ((n_missing++)) ;;
            *)       col="$RED";    ((n_invalid++)) ;;
        esac

        if [[ "$st" == "invalid" ]]; then
            printf '%b%-8s%b %-8s %-26s %s\n' \
                "$col" "$st" "$RESET" "-" "-" "${LS_FILE[$k]}"
            printf '%-8s %-8s %-26s %s\n' "" "" "" "${LS_ERROR[$k]}"
        else
            local ch="-"
            [[ "${LS_CONTENT[$k]}" == "1" ]] && ch="sha256"
            printf '%b%-8s%b %-8s %-26s %s\n' \
                "$col" "$st" "$RESET" "$ch" "${LS_CREATED[$k]}" "$k"
        fi
    done < <(printf '%s\0' "${!LS_STATUS[@]}" | LC_ALL=C sort -z)

    echo
    echo "Total: $total  (exists: $n_exists, missing: $n_missing, invalid: $n_invalid)"

    if (( n_missing > 0 )); then
        echo "Tip: remove a baseline of a deleted target with: perm --remove PATH"
    fi

    echo

    return 0
}


list_baselines_json() {
    collect_baselines

    local total=${#LS_STATUS[@]}
    local k st first=1

    echo "{"
    echo "  \"store\": \"$(json_escape "$BASELINE_DIR")\","
    echo "  \"count\": $total,"

    if (( total == 0 )); then
        echo "  \"baselines\": []"
        echo "}"
        return 0
    fi

    echo "  \"baselines\": ["

    while IFS= read -r -d '' k; do
        st="${LS_STATUS[$k]}"

        (( first )) || echo "    },"
        first=0

        echo "    {"

        if [[ "$st" == "invalid" ]]; then
            echo "      \"valid\": false,"
            echo "      \"file\": \"$(json_escape "${LS_FILE[$k]}")\","
            echo "      \"error\": \"$(json_escape "${LS_ERROR[$k]}")\""
        else
            echo "      \"path\": \"$(json_escape "$k")\","
            echo "      \"created\": \"$(json_escape "${LS_CREATED[$k]}")\","
            echo "      \"target_exists\": $([[ "$st" == "exists" ]] && echo true || echo false),"
            echo "      \"content_hash\": $([[ "${LS_CONTENT[$k]}" == "1" ]] && echo true || echo false),"
            echo "      \"valid\": true,"
            echo "      \"file\": \"$(json_escape "${LS_FILE[$k]}")\""
        fi
    done < <(printf '%s\0' "${!LS_STATUS[@]}" | LC_ALL=C sort -z)

    echo "    }"
    echo "  ]"
    echo "}"

    return 0
}


# ------------------------------------------------------------
# --remove
# ------------------------------------------------------------
# Deletes ONLY the baseline file that belongs to PATH.
# PATH itself is never touched, and it does not have to exist.

baseline_remove() {
    local path="$1"

    path=$(strip_trailing_slashes "$path")

    local abs
    abs=$(abs_path "$path")

    [[ "$abs" != *$'\n'* ]] ||
        error "Paths containing newlines are not supported for baselines"

    resolve_baseline_paths "$abs"

    [[ -f "$BASELINE_FILE" ]] ||
        error "No baseline for $abs"

    # Show when it was created, if the file is still readable/valid.
    local created="unknown"

    if read_baseline "$BASELINE_FILE"; then
        created="${BL[created]}"
    fi

    rm -f -- "$BASELINE_FILE" ||
        error "Cannot remove baseline file: $BASELINE_FILE"

    echo
    echo "Target   : $path"
    echo "Absolute : $abs"
    echo "Created  : $created"
    echo
    echo -e "${GREEN}Baseline removed.${RESET}"
    echo

    return 0
}


# ============================================================
# Directory Scan (3.0)
# ============================================================
#
# perm --scan DIR            create baselines for the files in DIR
# perm --scan --check DIR    compare the files in DIR with their baselines
#
# Built on the single-file baseline engine: every file in DIR gets its own
# baseline (same format, same store as --baseline). With --recursive the
# whole tree below DIR is covered (directories included).
#
# The per-file work is done by the non-fatal cores baseline_store and
# check_compare (they never exit and never print: they return a status and
# set CORE_ERR), so the scan can call them in a plain loop, without a
# subshell per file. A file that cannot be processed becomes an [ERROR]
# row; the scan goes on.

SCAN_DIR=""
SCAN_ABS=""
SCAN_ENTRIES=()

# One row per reported item (parallel arrays).
R_NAME=()      # name shown to the user
R_PATH=()      # absolute path
R_STATUS=()    # unchanged changed new deleted invalid error skip
               # created updated exists
R_DETAIL=()    # change list / reason / error message
R_FLAGS=()     # "perm own special type content" (0/1), check mode only
declare -A SC_COUNT=()

# Recursive scan (--scan --recursive)
declare -A SC_MOUNTS=()   # mount points below DIR (never entered)
SC_UNREADABLE=()          # directories that could not be read
SC_STORE_REAL=""          # real path of the baseline store
SC_PREFIX=""              # "DIR/" (names are shown relative to it)


scan_reset() {
    R_NAME=() R_PATH=() R_STATUS=() R_DETAIL=() R_FLAGS=()
    SC_COUNT=()
    SCAN_ENTRIES=()
    SC_MOUNTS=()
    SC_UNREADABLE=()
    SC_STORE_REAL=""
}


# scan_add NAME PATH STATUS DETAIL [FLAGS]
scan_add() {
    R_NAME+=("$1")
    R_PATH+=("$2")
    R_STATUS+=("$3")
    R_DETAIL+=("$4")
    R_FLAGS+=("${5:-}")
    SC_COUNT["$3"]=$(( ${SC_COUNT[$3]:-0} + 1 ))
}


# Validates DIR and sets SCAN_DIR / SCAN_ABS.
scan_prepare_dir() {
    local dir="$1"

    dir=$(strip_trailing_slashes "$dir")

    [[ -e "$dir" || -L "$dir" ]] ||
        error "Directory does not exist: $dir"

    if [[ -L "$dir" ]]; then
        error "$dir is a symbolic link; pass the real directory instead: $(readlink -f -- "$dir")"
    fi

    [[ -d "$dir" ]] ||
        error "Not a directory: $dir"

    [[ -r "$dir" && -x "$dir" ]] ||
        error "Cannot read directory: $dir"

    SCAN_DIR="$dir"
    SCAN_ABS=$(abs_path "$dir")

    [[ "$SCAN_ABS" != *$'\n'* ]] ||
        error "Paths containing newlines are not supported for baselines"

    SC_PREFIX="$SCAN_ABS/"
    [[ "$SCAN_ABS" == "/" ]] && SC_PREFIX="/"
}


# Escapes the characters that are special in a find -path pattern.
find_glob_escape() {
    local s="$1"

    s=${s//\\/\\\\}
    s=${s//\*/\\*}
    s=${s//\?/\\?}
    s=${s//\[/\\[}

    printf '%s' "$s"
}


# Mount points strictly below DIR  ->  SC_MOUNTS[path]=1
# (/proc/self/mountinfo escapes space, tab, newline and backslash as \NNN).
scan_load_mounts() {
    local line id pid dev root mp rest

    SC_MOUNTS=()

    [[ -r /proc/self/mountinfo ]] || return 0

    while IFS= read -r line; do

        read -r id pid dev root mp rest <<< "$line"

        mp=${mp//\\040/ }
        mp=${mp//\\011/$'\t'}
        mp=${mp//\\012/$'\n'}
        mp=${mp//\\134/\\}

        [[ "$mp" == "$SC_PREFIX"* && "$mp" != "$SCAN_ABS" ]] || continue

        SC_MOUNTS["$mp"]=1

    done < /proc/self/mountinfo
}


# Sorted list of what is scanned: the immediate children of DIR (dotfiles
# included) or, with --recursive, everything below DIR. A recursive listing
# never follows symbolic links, never crosses a file system boundary
# (-xdev, plus an explicit prune of every mount point, which also covers
# bind mounts) and does not enter perm's own baseline store. The pruned
# directories themselves are still listed, so they can be reported as [SKIP].
scan_list_entries() {
    local p m

    SCAN_ENTRIES=()

    if (( ! RECURSIVE_MODE )); then

        while IFS= read -r -d '' p; do
            SCAN_ENTRIES+=("$p")
        done < <(find "$SCAN_ABS" -mindepth 1 -maxdepth 1 -print0 2>/dev/null |
                 LC_ALL=C sort -z)

        return 0
    fi

    scan_load_mounts

    SC_STORE_REAL=$(readlink -f -- "$BASELINE_DIR" 2>/dev/null) || SC_STORE_REAL=""
    [[ "$SC_STORE_REAL" == "$BASELINE_DIR" ]] && SC_STORE_REAL=""

    local -a prune=() fargs=()

    for m in "$BASELINE_DIR" "$SC_STORE_REAL" "${!SC_MOUNTS[@]}"; do
        [[ -n "$m" ]] || continue
        prune+=( -path "$(find_glob_escape "$m")" -o )
    done

    if (( ${#prune[@]} )); then
        unset 'prune[${#prune[@]}-1]'
        fargs=( "$SCAN_ABS" -xdev -mindepth 1
                '(' "${prune[@]}" ')' -prune -print0 -o -print0 )
    else
        fargs=( "$SCAN_ABS" -xdev -mindepth 1 -print0 )
    fi

    while IFS= read -r -d '' p; do
        SCAN_ENTRIES+=("$p")
    done < <(find "${fargs[@]}" 2>/dev/null | LC_ALL=C sort -z)

    # find silently drops a mount point that is a bind mount of one of its
    # own ancestors ("file system loop"). Report such mount points anyway,
    # unless they lie below another mount point (which is never entered).
    local -A seen=()
    local parent added=0

    for p in "${SCAN_ENTRIES[@]}"; do
        seen["$p"]=1
    done

    for m in "${!SC_MOUNTS[@]}"; do

        [[ -n "${seen[$m]:-}" ]] && continue

        parent="${m%/*}"
        [[ -z "$parent" ]] && parent="/"

        [[ -n "${SC_MOUNTS[$parent]:-}" ]] && continue

        if [[ "$parent" == "$SCAN_ABS" || -n "${seen[$parent]:-}" ]]; then
            SCAN_ENTRIES+=("$m")
            added=1
        fi

    done

    if (( added )); then
        local -a sorted=()

        while IFS= read -r -d '' p; do
            sorted+=("$p")
        done < <(printf '%s\0' "${SCAN_ENTRIES[@]}" | LC_ALL=C sort -z)

        SCAN_ENTRIES=("${sorted[@]}")
    fi
}


# perm's own baseline store must never be scanned (its files would be
# baselined, and every baseline written would change the tree).
scan_entry_is_store() {
    [[ "$1" == "$BASELINE_DIR" ||
       ( -n "$SC_STORE_REAL" && "$1" == "$SC_STORE_REAL" ) ]]
}


scan_dir_readable() {
    [[ -r "$1" && -x "$1" ]]
}


# Is PATH inside a directory that could not be read? (Its baselines must not
# be reported as deleted just because they cannot be seen from here.)
scan_under_unreadable() {
    local path="$1" d

    for d in "${SC_UNREADABLE[@]}"; do
        [[ "$path" == "$d"/* ]] && return 0
    done

    return 1
}


scan_entry_is_dir() {
    [[ -d "$1" && ! -L "$1" ]]
}


# ------------------------------------------------------------
# --scan  (collect)
# ------------------------------------------------------------

scan_collect_create() {
    local force="$1"
    local p name existed

    scan_reset
    scan_list_entries

    for p in "${SCAN_ENTRIES[@]}"; do

        if (( RECURSIVE_MODE )); then
            name="${p#"$SC_PREFIX"}"
        else
            name="${p##*/}"
        fi

        if [[ "$p" == *$'\n'* ]]; then
            scan_add "$name" "$p" error \
                "Paths containing newlines are not supported for baselines"
            continue
        fi

        if (( RECURSIVE_MODE )); then

            if scan_entry_is_store "$p"; then
                scan_add "$name/" "$p" skip "baseline store, not scanned" store
                continue
            fi

            if scan_entry_is_dir "$p"; then

                if [[ -n "${SC_MOUNTS[$p]:-}" ]]; then
                    scan_add "$name/" "$p" skip "mount point, not entered" mount
                    continue
                fi

                if ! scan_dir_readable "$p"; then
                    scan_add "$name/" "$p" error \
                        "directory cannot be read; its contents were not scanned"
                    SC_UNREADABLE+=("$p")
                    continue
                fi

                name="$name/"
            fi

        elif scan_entry_is_dir "$p"; then
            scan_add "$name/" "$p" skip "subdirectory, not scanned"
            continue
        fi

        resolve_baseline_paths "$p"

        existed=0
        [[ -e "$BASELINE_FILE" ]] && existed=1

        if (( existed && ! force )); then
            scan_add "$name" "$p" exists "baseline exists"
            continue
        fi

        # BASELINE_FILE is already resolved for $p (just above).
        if baseline_store "$p" "$p" "$force" 0; then
            if (( BL_EXISTED )); then
                scan_add "$name" "$p" updated "baseline updated"
            else
                scan_add "$name" "$p" created "baseline created"
            fi
        else
            scan_add "$name" "$p" error "${CORE_ERR%%$'\n'*}"
        fi

    done
}


# ------------------------------------------------------------
# --scan --check  (collect)
# ------------------------------------------------------------

# Builds SC_DETAIL, the human-readable list of what changed, from the
# globals left by check_compare (the file must exist and have changed).
scan_change_detail() {
    local -a parts=()
    local -a fw=(DISABLED ENABLED)
    local part

    SC_DETAIL=""

    if (( D_PERM )); then
        parts+=("permissions ${BL[octal]:1} -> ${CUR_OCTAL:1}")
    fi

    if (( D_OWN )); then
        parts+=("ownership ${BL[owner]}(${BL[uid]}):${BL[group]}(${BL[gid]}) -> ${CUR_OWNER}(${CUR_UID}):${CUR_GROUP}(${CUR_GID})")
    fi

    if (( D_SPEC )); then
        [[ "${BL[suid]}" != "$CUR_SUID" ]] &&
            parts+=("SUID ${fw[${BL[suid]}]} -> ${fw[$CUR_SUID]}")
        [[ "${BL[sgid]}" != "$CUR_SGID" ]] &&
            parts+=("SGID ${fw[${BL[sgid]}]} -> ${fw[$CUR_SGID]}")
        [[ "${BL[sticky]}" != "$CUR_STICKY" ]] &&
            parts+=("Sticky ${fw[${BL[sticky]}]} -> ${fw[$CUR_STICKY]}")
    fi

    if (( D_TYPE )); then
        parts+=("type ${BL[type]} -> $CUR_TYPE")
    fi

    if (( D_CONTENT )); then
        parts+=("content SHA-256 changed")
    fi

    for part in "${parts[@]}"; do
        SC_DETAIL+="${SC_DETAIL:+; }$part"
    done
}


# Baselines of files that no longer exist in DIR  ->  [DELETED] rows.
#
# Only baselines whose stored path is a direct child of DIR and whose target
# is gone are validated further (the file name must match the hash of the
# stored path, exactly like collect_baselines does), so a big store costs
# one cheap read per baseline instead of several forks.
scan_find_deleted() {
    local f path rest prefix key name
    local -a gone=()
    local -A gone_dir=()

    resolve_baseline_dir

    [[ -d "$BASELINE_DIR" ]] || return 0

    prefix="$SCAN_ABS/"
    [[ "$SCAN_ABS" == "/" ]] && prefix="/"

    while IFS= read -r -d '' f; do

        read_baseline "$f" || continue

        path="${BL[path]}"

        [[ "$path" == "$prefix"* ]] || continue

        rest="${path#"$prefix"}"

        # Non-recursive: direct children only. Recursive: any depth.
        if (( RECURSIVE_MODE )); then
            [[ -n "$rest" ]] || continue
        else
            [[ -n "$rest" && "$rest" != */* ]] || continue
        fi

        [[ -e "$path" || -L "$path" ]] && continue

        # Inside a directory we could not read: not "deleted", just unseen.
        if (( RECURSIVE_MODE )) && scan_under_unreadable "$path"; then
            continue
        fi

        baseline_name_matches "$f" "$path" || continue

        gone+=("$path")

        # Recursive scans show directories with a trailing slash.
        [[ "${BL[type]}" == "directory" ]] && gone_dir["$path"]=1

    done < <(find "$BASELINE_DIR" -maxdepth 1 -type f -name '*.baseline' -print0 2>/dev/null)

    (( ${#gone[@]} )) || return 0

    while IFS= read -r -d '' key; do
        name="${key#"$prefix"}"
        (( RECURSIVE_MODE )) && [[ -n "${gone_dir[$key]:-}" ]] && name+="/"
        scan_add "$name" "$key" deleted "baseline exists, target gone"
    done < <(printf '%s\0' "${gone[@]}" | LC_ALL=C sort -z)
}


scan_collect_check() {
    local p name

    scan_reset
    scan_list_entries

    for p in "${SCAN_ENTRIES[@]}"; do

        if (( RECURSIVE_MODE )); then
            name="${p#"$SC_PREFIX"}"
        else
            name="${p##*/}"
        fi

        if [[ "$p" == *$'\n'* ]]; then
            scan_add "$name" "$p" error \
                "Paths containing newlines are not supported for baselines"
            continue
        fi

        resolve_baseline_paths "$p"

        if (( RECURSIVE_MODE )); then

            if scan_entry_is_store "$p"; then
                scan_add "$name/" "$p" skip "baseline store, not scanned" store
                continue
            fi

            if scan_entry_is_dir "$p"; then

                if ! scan_dir_readable "$p"; then
                    scan_add "$name/" "$p" error \
                        "directory cannot be read; its contents were not checked"
                    SC_UNREADABLE+=("$p")
                    continue
                fi

                # A mount point is not entered; if it has a baseline of its
                # own it is still checked (its owner/mode can change).
                if [[ -n "${SC_MOUNTS[$p]:-}" && ! -f "$BASELINE_FILE" ]]; then
                    scan_add "$name/" "$p" skip "mount point, not entered" mount
                    continue
                fi

                name="$name/"
            fi

        # Subdirectories are not entered. But if one has a baseline of its
        # own (e.g. it used to be a file) it is still checked, otherwise a
        # file -> directory swap would go unnoticed.
        elif scan_entry_is_dir "$p"; then
            if [[ ! -f "$BASELINE_FILE" ]]; then
                scan_add "$name/" "$p" skip "subdirectory, not scanned"
                continue
            fi
            name="$name/"
        fi

        if [[ ! -f "$BASELINE_FILE" ]]; then
            scan_add "$name" "$p" new "no baseline"
            continue
        fi

        # Damaged baselines are detected here, non-fatally.
        if ! read_baseline "$BASELINE_FILE"; then
            scan_add "$name" "$p" invalid "${BL_ERROR%": $BASELINE_FILE"}"
            continue
        fi

        if [[ "${BL[path]}" != "$p" ]]; then
            scan_add "$name" "$p" invalid \
                "Baseline file does not belong to this path"
            continue
        fi

        # BL[] is loaded and valid for $p: compare with the current state.
        if ! check_compare "$p"; then
            scan_add "$name" "$p" error "${CORE_ERR%%$'\n'*}"
            continue
        fi

        if (( ! CHK_EXISTS )); then
            scan_add "$name" "$p" deleted "baseline exists, target gone"
        elif (( CHANGED )); then
            scan_change_detail
            scan_add "$name" "$p" changed "$SC_DETAIL" \
                "$D_PERM $D_OWN $D_SPEC $D_TYPE $D_CONTENT"
        else
            scan_add "$name" "$p" unchanged ""
        fi

    done

    scan_find_deleted
}


# ------------------------------------------------------------
# --scan  (render, text)
# ------------------------------------------------------------

scan_print_rows() {
    local i n=${#R_STATUS[@]}
    local width=1 label color safe detail
    local -a idx=()

    # --changes-only hides the rows that say "nothing happened".
    for (( i = 0; i < n; i++ )); do
        if (( CHANGES_ONLY )); then
            case "${R_STATUS[$i]}" in
                unchanged|exists) continue ;;
            esac
        fi
        idx+=("$i")
    done

    for i in "${idx[@]}"; do
        safe="${R_NAME[$i]//[[:cntrl:]]/?}"
        (( ${#safe} > width )) && width=${#safe}
    done

    (( width > 40 )) && width=40

    for i in "${idx[@]}"; do

        case "${R_STATUS[$i]}" in
            unchanged) label="[OK]";      color="$GREEN"  ;;
            created)   label="[CREATED]"; color="$GREEN"  ;;
            updated)   label="[UPDATED]"; color="$GREEN"  ;;
            changed)   label="[CHANGED]"; color="$RED"    ;;
            deleted)   label="[DELETED]"; color="$RED"    ;;
            invalid)   label="[INVALID]"; color="$RED"    ;;
            error)     label="[ERROR]";   color="$RED"    ;;
            new)       label="[NEW]";     color="$YELLOW" ;;
            exists)    label="[EXISTS]";  color="$YELLOW" ;;
            skip)      label="[SKIP]";    color="$YELLOW" ;;
            *)         label="[?]";       color=""        ;;
        esac

        # Never let a file name (or message) inject terminal escapes.
        safe="${R_NAME[$i]//[[:cntrl:]]/?}"
        detail="${R_DETAIL[$i]//[[:cntrl:]]/?}"

        printf '%b%-10s%b ' "$color" "$label" "$RESET"

        if [[ -z "$detail" ]]; then
            printf '%s\n' "$safe"
        elif [[ "${R_STATUS[$i]}" == "changed" ]]; then
            printf '%-*s  %s\n' "$width" "$safe" "$detail"
        else
            printf '%-*s  (%s)\n' "$width" "$safe" "$detail"
        fi

    done

    if (( CHANGES_ONLY && ${#idx[@]} == 0 )); then
        echo "(nothing to show: --changes-only hides [OK] and [EXISTS] rows)"
    fi
}


scan_create() {
    local dir="$1"
    local force="$2"
    local errs created updated exists skipped rc

    scan_prepare_dir "$dir"
    resolve_baseline_dir
    scan_collect_create "$force"

    created=${SC_COUNT[created]:-0}
    updated=${SC_COUNT[updated]:-0}
    exists=${SC_COUNT[exists]:-0}
    errs=${SC_COUNT[error]:-0}
    skipped=${SC_COUNT[skip]:-0}

    (( errs )) && rc=2 || rc=0

    echo
    echo -e "${BOLD}${BLUE}perm Scan${RESET}"
    echo "================================"
    if (( RECURSIVE_MODE )); then
        echo "Directory : $SCAN_ABS (recursive)"
    else
        echo "Directory : $SCAN_ABS"
    fi
    echo "Store     : $BASELINE_DIR"
    echo

    if (( ${#R_STATUS[@]} == 0 )); then
        echo "Directory is empty; nothing to scan."
    else
        scan_print_rows
    fi

    echo
    echo "Summary : $created created, $updated updated, $exists already had a baseline, $errs errors"
    if (( RECURSIVE_MODE )); then
        echo "Skipped : $skipped (mount points, baseline store)"
    else
        echo "Skipped subdirectories : $skipped"
    fi
    echo

    if (( errs )); then
        echo -e "${BOLD}${RED}Completed with $errs error(s).${RESET}"
    else
        echo -e "${BOLD}${GREEN}[OK] Scan complete.${RESET}"
    fi

    if (( exists )); then
        echo "Use --force to update existing baselines."
    fi

    echo

    return $rc
}


scan_check_text() {
    local rc="$1"
    local changes="$2"
    local errs=${SC_COUNT[error]:-0}

    echo
    echo -e "${BOLD}${BLUE}perm Scan Check${RESET}"
    echo "================================"
    if (( RECURSIVE_MODE )); then
        echo "Directory : $SCAN_ABS (recursive)"
    else
        echo "Directory : $SCAN_ABS"
    fi
    echo "Store     : $BASELINE_DIR"
    echo

    if (( ${#R_STATUS[@]} == 0 )); then
        echo "Directory is empty; nothing to scan."
    else
        scan_print_rows
    fi

    echo
    echo "Summary : ${SC_COUNT[unchanged]:-0} unchanged, ${SC_COUNT[changed]:-0} changed, ${SC_COUNT[new]:-0} new, ${SC_COUNT[deleted]:-0} deleted, ${SC_COUNT[invalid]:-0} invalid, $errs errors"
    if (( RECURSIVE_MODE )); then
        echo "Skipped : ${SC_COUNT[skip]:-0} (mount points, baseline store)"
    else
        echo "Skipped subdirectories : ${SC_COUNT[skip]:-0}"
    fi
    echo

    case "$rc" in
        0)
            echo -e "${BOLD}${GREEN}[OK] No changes detected.${RESET}"
            ;;
        1)
            echo -e "${BOLD}${RED}[CHANGE DETECTED]${RESET} Differences found."
            ;;
        *)
            echo -e "${BOLD}${RED}[INCOMPLETE]${RESET} $errs item(s) could not be checked; the result cannot be trusted."
            (( changes )) && echo "Changes were also detected (see above)."
            ;;
    esac

    echo
}


# ------------------------------------------------------------
# --json --scan --check  (render)
# ------------------------------------------------------------

scan_check_json() {
    local rc="$1"
    local changes="$2"
    local i n=${#R_STATUS[@]}
    local scanned=0 status row f reason skipkey="skipped_subdirectories"
    local -a rows=() skipped=()
    local -a fl=()

    for (( i = 0; i < n; i++ )); do

        status="${R_STATUS[$i]}"

        if [[ "$status" == "skip" ]]; then
            if (( RECURSIVE_MODE )); then
                reason="mount point"
                [[ "${R_FLAGS[$i]}" == "store" ]] && reason="baseline store"
                skipped+=("{ \"path\": \"$(json_escape "${R_PATH[$i]}")\", \"reason\": \"$reason\" }")
            else
                skipped+=("\"$(json_escape "${R_PATH[$i]}")\"")
            fi
            continue
        fi

        [[ "$status" != "deleted" ]] && (( scanned++ ))

        row="{ \"path\": \"$(json_escape "${R_PATH[$i]}")\", \"status\": \"$status\""

        case "$status" in
            changed)
                read -r -a fl <<< "${R_FLAGS[$i]}"
                row+=", \"changes\": { \"permissions\": $(json_bool "${fl[0]}"), \"ownership\": $(json_bool "${fl[1]}"), \"special_bits\": $(json_bool "${fl[2]}"), \"type\": $(json_bool "${fl[3]}"), \"content\": $(json_bool "${fl[4]}") }"
                ;;
            invalid|error)
                row+=", \"error\": \"$(json_escape "${R_DETAIL[$i]}")\""
                ;;
        esac

        row+=" }"
        rows+=("$row")

    done

    echo "{"
    echo "  \"directory\": \"$(json_escape "$SCAN_ABS")\","

    if (( RECURSIVE_MODE )); then
        echo "  \"recursive\": true,"
        skipkey="skipped"
    fi

    echo "  \"scanned\": $scanned,"
    echo "  \"changed\": $(json_bool "$(( changes > 0 ))"),"
    echo "  \"complete\": $(json_bool "$(( ${SC_COUNT[error]:-0} == 0 ))"),"

    if (( ${#rows[@]} == 0 )); then
        echo "  \"results\": [],"
    else
        echo "  \"results\": ["
        for (( i = 0; i < ${#rows[@]}; i++ )); do
            if (( i < ${#rows[@]} - 1 )); then
                echo "    ${rows[$i]},"
            else
                echo "    ${rows[$i]}"
            fi
        done
        echo "  ],"
    fi

    echo "  \"summary\": {"
    echo "    \"unchanged\": ${SC_COUNT[unchanged]:-0},"
    echo "    \"changed\": ${SC_COUNT[changed]:-0},"
    echo "    \"new\": ${SC_COUNT[new]:-0},"
    echo "    \"deleted\": ${SC_COUNT[deleted]:-0},"
    echo "    \"invalid\": ${SC_COUNT[invalid]:-0},"
    echo "    \"errors\": ${SC_COUNT[error]:-0}"
    echo "  },"

    if (( ${#skipped[@]} == 0 )); then
        echo "  \"$skipkey\": []"
    else
        echo "  \"$skipkey\": ["
        for (( i = 0; i < ${#skipped[@]}; i++ )); do
            if (( i < ${#skipped[@]} - 1 )); then
                echo "    ${skipped[$i]},"
            else
                echo "    ${skipped[$i]}"
            fi
        done
        echo "  ]"
    fi

    echo "}"
}


scan_check() {
    local dir="$1"
    local as_json="$2"
    local changes rc

    scan_prepare_dir "$dir"
    resolve_baseline_dir
    scan_collect_check

    changes=$(( ${SC_COUNT[changed]:-0} + ${SC_COUNT[new]:-0} +
                ${SC_COUNT[deleted]:-0} + ${SC_COUNT[invalid]:-0} ))

    # 2 = scan incomplete (a file could not be checked): an unchecked file
    #     is not a clean file, so the result cannot be trusted.
    # 1 = differences detected, 0 = everything unchanged.
    if (( ${SC_COUNT[error]:-0} )); then
        rc=2
    elif (( changes )); then
        rc=1
    else
        rc=0
    fi

    if (( as_json )); then
        scan_check_json "$rc" "$changes"
    else
        scan_check_text "$rc" "$changes"
    fi

    return $rc
}


# ============================================================
# Effective Access (--why)
# ============================================================
#
# perm --why USER ACTION PATH
#
# Answers: "can USER read / write / execute PATH, and why (not)?"
# It follows the same algorithm as the Linux kernel's classic
# DAC (mode bits + ownership) check:
#
#   1. Walk the path component by component. USER needs search
#      permission (x) on EVERY directory that is traversed.
#   2. Symbolic links met on the way are followed (the link's own
#      mode bits are ignored by Linux); at most 40 hops.
#   3. On every inode only ONE class is checked, the first match:
#         owner  (uid == file uid)
#         group  (file gid is one of USER's groups)
#         others
#      A more permissive later class can NOT rescue the user.
#   4. uid 0 bypasses r/w checks. Execute on a non-directory still
#      needs at least one x bit.
#   5. delete (unlink/rmdir of the LAST component, which is not
#      followed): needs w+x on the parent directory and nothing on the
#      entry itself; with the sticky bit on the parent only the entry's
#      owner, the directory's owner or root may delete.
#   6. Mount options: ro blocks write/delete, noexec blocks execute of
#      regular files (even for root). Only applied when the mode bits
#      already allow the action.
#   7. ACL entries are only DETECTED (ls shows a trailing "+"): a warning
#      is printed, the ACL itself is not evaluated.
#
# Not considered: ACL evaluation, SELinux/AppArmor, capabilities,
# chattr +i, network file systems.

WHY_ACTION=""
WHY_INPUT_PATH=""
WHY_TRAILING_SLASH=0
WHY_DELETE=0
WHY_DEL_DONE=0

WHY_MOUNT_PATH=""
WHY_PARENT=""
WHY_PARENT_LABEL=""
WHY_TARGET_TYPE=""
WHY_STICKY_TEXT=""

WHY_UID=""
WHY_GID=""
WHY_UNAME=""
WHY_GROUPS=()

WHY_NEED=0
WHY_NEED_STR=""

WHY_RESOLVED=""
WHY_ALLOWED=1
WHY_REASON=""
WHY_NOTE=""

WS_KIND=()
WS_PATH=()
WS_SYM=()
WS_OWNER=()
WS_CLASS=()
WS_LABEL=()
WS_BITS=()
WS_NEED=()
WS_OK=()
WS_LINK=()

# Results of why_eval
E_CLASS=""
E_LABEL=""
E_BITS=""
E_OK=0
E_NOTE=""

# Results of why_stat
S_TYPE=""
S_MODE=""
S_UID=""
S_GID=""
S_SYM=""
S_OWNER=""
S_GROUP=""
S_ERR=""


# Sets WHY_UID, WHY_GID, WHY_UNAME, WHY_GROUPS.
# (Called directly, not inside $(...), so error() can exit the script.)
why_resolve_user() {
    local user="$1"
    local groups

    WHY_UID=$(id -u -- "$user" 2>/dev/null) ||
        error "Unknown user: $user"

    WHY_GID=$(id -g -- "$user" 2>/dev/null) ||
        error "Unknown user: $user"

    WHY_UNAME=$(id -un -- "$user" 2>/dev/null) ||
        WHY_UNAME="$user"

    groups=$(id -G -- "$user" 2>/dev/null) ||
        error "Unknown user: $user"

    read -r -a WHY_GROUPS <<< "$groups"

    # id -G lists the primary group too, but make sure of it.
    local g found=0
    for g in "${WHY_GROUPS[@]}"; do
        [[ "$g" == "$WHY_GID" ]] && found=1
    done
    (( found )) || WHY_GROUPS+=("$WHY_GID")
}


why_group_name() {
    local gid="$1"
    local entry

    entry=$(getent group "$gid" 2>/dev/null) || entry=""

    if [[ -n "$entry" ]]; then
        printf '%s' "${entry%%:*}"
    else
        printf '%s' "$gid"
    fi
}


why_in_group() {
    local gid="$1" g

    for g in "${WHY_GROUPS[@]}"; do
        [[ "$g" == "$gid" ]] && return 0
    done

    return 1
}


why_bits_str() {
    local b="$1" s=""

    (( b & 4 )) && s+="r" || s+="-"
    (( b & 2 )) && s+="w" || s+="-"
    (( b & 1 )) && s+="x" || s+="-"

    printf '%s' "$s"
}


# stat(1) of one path WITHOUT following a final symlink.
# Sets S_TYPE S_MODE S_UID S_GID S_SYM S_OWNER S_GROUP.
# Returns 1 and sets S_ERR (enoent|eacces|enotdir|eloop|other).
why_stat() {
    local p="$1" out

    if ! out=$(LC_ALL=C stat -c '%F|%a|%u|%g|%A|%U|%G' -- "$p" 2>&1); then
        case "$out" in
            *"No such file"*)        S_ERR="enoent" ;;
            *"Permission denied"*)   S_ERR="eacces" ;;
            *"Not a directory"*)     S_ERR="enotdir" ;;
            *"Too many levels"*)     S_ERR="eloop" ;;
            *)                       S_ERR="other" ;;
        esac
        return 1
    fi

    IFS='|' read -r S_TYPE S_MODE S_UID S_GID S_SYM S_OWNER S_GROUP <<< "$out"

    return 0
}


# Does WHY_UID have the permission bits in $need (4=r 2=w 1=x, summed)
# on an inode?  Only ONE class is checked: the first that matches.
#
#   why_eval ISDIR MODE FILE_UID FILE_GID NEED
#
# Sets E_CLASS (root|owner|group|others), E_LABEL, E_BITS, E_OK, E_NOTE.
why_eval() {
    local isdir="$1" mode="$2" fuid="$3" fgid="$4" need="$5"

    mode=$(normalize_octal "$mode")

    local ob="${mode:1:1}" gb="${mode:2:1}" tb="${mode:3:1}"
    local bits

    E_NOTE=""

    if (( WHY_UID == 0 )); then

        E_CLASS="root"
        E_LABEL="root"

        # r/w are always granted; x only on directories, or on files
        # that have at least one x bit.
        if (( isdir )) || (( (ob | gb | tb) & 1 )); then
            bits=7
        else
            bits=6
        fi

    elif (( WHY_UID == fuid )); then

        E_CLASS="owner"
        E_LABEL="owner"
        bits="$ob"

    elif why_in_group "$fgid"; then

        E_CLASS="group"
        E_LABEL="group($(why_group_name "$fgid"))"
        bits="$gb"

    else

        E_CLASS="others"
        E_LABEL="others"
        bits="$tb"

    fi

    E_BITS=$(why_bits_str "$bits")

    if (( (bits & need) == need )); then
        E_OK=1
        return 0
    fi

    E_OK=0

    # Would a LATER (less specific) class have allowed it?
    local later=""

    if [[ "$E_CLASS" == "owner" ]]; then
        (( (gb & need) == need )) && later="group"
        if (( (tb & need) == need )); then
            [[ -n "$later" ]] && later+=" and others" || later="others"
        fi
    elif [[ "$E_CLASS" == "group" ]]; then
        (( (tb & need) == need )) && later="others"
    fi

    if [[ -n "$later" ]]; then
        E_NOTE="the $later class would allow this, but Linux checks only the first matching class ($E_CLASS), and that class does not"
    fi

    return 0
}


why_need_str() {
    case "$1" in
        4) printf 'r' ;;
        2) printf 'w' ;;
        1) printf 'x' ;;
        3) printf 'w+x' ;;
        *) printf '?' ;;
    esac
}


# Records the result of why_eval as a step.
# why_add_step KIND PATH NEED
why_add_step() {
    local kind="$1" path="$2" need="$3"

    WS_KIND+=("$kind")
    WS_PATH+=("$path")
    WS_SYM+=("$S_SYM")
    WS_OWNER+=("$S_OWNER:$S_GROUP")
    WS_CLASS+=("$E_CLASS")
    WS_LABEL+=("$E_LABEL")
    WS_BITS+=("$E_BITS")
    WS_NEED+=("$(why_need_str "$need")")
    WS_OK+=("$E_OK")
    WS_LINK+=("")
}


why_add_link() {
    WS_KIND+=("symlink")
    WS_PATH+=("$1")
    WS_SYM+=("")
    WS_OWNER+=("")
    WS_CLASS+=("")
    WS_LABEL+=("")
    WS_BITS+=("")
    WS_NEED+=("")
    WS_OK+=("1")
    WS_LINK+=("$2")
}


# A step that denied access: remember why, so the result can say it.
why_deny() {
    local path="$1" what="$2" need="$3"

    WHY_ALLOWED=0
    WHY_NOTE="$E_NOTE"

    if [[ "$E_CLASS" == "root" ]]; then
        WHY_REASON="$what $path: root needs at least one execute bit on a non-directory"
    else
        WHY_REASON="$what $path: $E_LABEL class has \"$E_BITS\", but $(why_need_str "$need") is required"
    fi
}


# Explains a failed stat() of the next path component. Never returns.
why_die_stat() {
    local next="$1" cur="$2"

    case "$S_ERR" in
        enoent)
            error "Path does not exist: $next" ;;
        eacces)
            error "Cannot inspect $next: permission denied for the current user (run perm with sudo for a complete analysis)" ;;
        enotdir)
            error "Not a directory: $cur" ;;
        eloop)
            error "Too many levels of symbolic links: $next" ;;
        *)
            error "Cannot inspect $next" ;;
    esac
}


# Records a step that is not a plain permission check.
# why_add_raw KIND PATH SYM OWNER CLASS LABEL BITS NEED OK DETAIL
why_add_raw() {
    WS_KIND+=("$1")
    WS_PATH+=("$2")
    WS_SYM+=("$3")
    WS_OWNER+=("$4")
    WS_CLASS+=("$5")
    WS_LABEL+=("$6")
    WS_BITS+=("$7")
    WS_NEED+=("$8")
    WS_OK+=("$9")
    WS_LINK+=("${10}")
}


# ------------------------------------------------------------
# Mount options (only ro and noexec matter for access)
# ------------------------------------------------------------

M_OK=0
M_POINT=""
M_FSTYPE=""
M_RO=0
M_NOEXEC=0

# Finds the mount that holds path $1 (longest mount point wins; of two
# mounts on the same point the later one, which is on top, wins).
# Sets M_OK M_POINT M_FSTYPE M_RO M_NOEXEC.
why_mount_info() {
    local p="$1"
    local line id pid dev root mp mopts rest
    local best=-1 b_mp="" b_mopts="" b_rest=""
    local after fst src sopts

    M_OK=0

    [[ -r /proc/self/mountinfo ]] || return 1

    while IFS= read -r line; do

        read -r id pid dev root mp mopts rest <<< "$line"

        # mountinfo escapes space, tab, newline and backslash as \NNN
        mp=${mp//\\040/ }
        mp=${mp//\\011/$'\t'}
        mp=${mp//\\012/$'\n'}
        mp=${mp//\\134/\\}

        if [[ "$mp" == "/" || "$p" == "$mp" || "$p" == "$mp"/* ]]; then
            if (( ${#mp} >= best )); then
                best=${#mp}
                b_mp="$mp"
                b_mopts="$mopts"
                b_rest="$rest"
            fi
        fi

    done < /proc/self/mountinfo

    (( best >= 0 )) || return 1

    # "... mount-options [optional fields] - fstype source super-options"
    b_rest=" $b_rest"
    after="${b_rest#* - }"
    read -r fst src sopts <<< "$after"

    M_POINT="$b_mp"
    M_FSTYPE="$fst"

    M_RO=0
    [[ ",$b_mopts,$sopts," == *,ro,* ]] && M_RO=1

    M_NOEXEC=0
    [[ ",$b_mopts," == *,noexec,* ]] && M_NOEXEC=1

    M_OK=1
    return 0
}


# Applies the mount restriction, but only when the mode bits allowed it.
why_mount_apply() {
    (( M_OK )) || return 0
    (( WHY_ALLOWED )) || return 0

    local opt="" need="" detail=""

    case "$WHY_ACTION" in

        write)
            if (( M_RO )) &&
               [[ "$WHY_TARGET_TYPE" == regular* || "$WHY_TARGET_TYPE" == directory ]]; then
                opt="ro"
                need="rw"
                detail="mount $M_POINT is read-only (ro): writing is blocked regardless of the mode bits"
            fi
            ;;

        delete)
            if (( M_RO )); then
                opt="ro"
                need="rw"
                detail="mount $M_POINT is read-only (ro): deleting is blocked regardless of the mode bits"
            fi
            ;;

        execute)
            if (( M_NOEXEC )) && [[ "$WHY_TARGET_TYPE" == regular* ]]; then
                opt="noexec"
                need="exec"
                detail="mount $M_POINT is mounted noexec: executing files is blocked, even for root"
            fi
            ;;

    esac

    [[ -n "$opt" ]] || return 0

    why_add_raw "mount" "$M_POINT" "" "" "mount" "" "$opt" "$need" "0" "$detail"

    WHY_ALLOWED=0
    WHY_NOTE=""
    WHY_REASON="$detail"
}


# ------------------------------------------------------------
# ACL detection (warning only: ACL entries are NOT evaluated)
# ------------------------------------------------------------

WHY_ACL_PATHS=()

# One ls call over every inode that took part; a trailing "+" in the
# mode string means the inode has ACL entries.
why_acl_scan() {
    WHY_ACL_PATHS=()

    local i n="${#WS_KIND[@]}" p
    local paths=()
    local -A seen=()

    for (( i = 0; i < n; i++ )); do

        case "${WS_KIND[i]}" in
            directory|parent|target|entry) ;;
            *) continue ;;
        esac

        p="${WS_PATH[i]}"

        [[ -n "${seen[$p]:-}" ]] && continue

        seen["$p"]=1
        paths+=("$p")
    done

    (( ${#paths[@]} > 0 )) || return 0

    local out lines=()

    out=$(LC_ALL=C ls -ldqU -- "${paths[@]}" 2>/dev/null) || return 0

    mapfile -t lines <<< "$out"

    (( ${#lines[@]} == ${#paths[@]} )) || return 0

    for (( i = 0; i < ${#paths[@]}; i++ )); do
        [[ "${lines[i]%% *}" == *+ ]] && WHY_ACL_PATHS+=("${paths[i]}")
    done

    return 0
}


# Walks the path like the kernel does and fills the WS_* arrays.
# Stops at the first denial (like the kernel: EACCES).
#
# For ACTION delete the LAST component is not followed: unlink/rmdir work
# on the directory entry, so what counts is the parent directory (w+x),
# the sticky bit, and nothing on the entry itself.
#
# Calls error() for unusable input, so it must not run in $(...).
why_walk() {
    local start="$1"
    local rest="$start"
    local cur="/"
    local hops=0
    local comp next target parent
    local is_last

    # Information about "cur" (always a directory when we look inside it)
    local c_type c_mode c_uid c_gid c_sym c_owner c_group

    WHY_DEL_DONE=0

    why_stat "/" || error "Cannot inspect /"

    c_type="$S_TYPE"; c_mode="$S_MODE"; c_uid="$S_UID"; c_gid="$S_GID"
    c_sym="$S_SYM"; c_owner="$S_OWNER"; c_group="$S_GROUP"

    while :; do

        while [[ "$rest" == /* ]]; do
            rest="${rest#/}"
        done

        [[ -z "$rest" ]] && break

        if [[ "$rest" == */* ]]; then
            comp="${rest%%/*}"
            rest="${rest#*/}"
        else
            comp="$rest"
            rest=""
        fi

        while [[ "$rest" == /* ]]; do
            rest="${rest#/}"
        done

        is_last=0
        [[ -z "$rest" ]] && is_last=1

        [[ "$comp" == "." ]] && continue

        # --- cur must be a directory, and USER needs x on it ---
        if [[ "$c_type" != "directory" ]]; then
            error "Not a directory: $cur"
        fi

        if [[ "$cur" == "/" ]]; then
            next="/$comp"
        else
            next="$cur/$comp"
        fi

        # ----------------------------------------------------
        # delete: the last component is the entry being removed
        # ----------------------------------------------------
        if (( WHY_DELETE && is_last )) && [[ "$comp" != ".." ]]; then

            S_SYM="$c_sym"; S_OWNER="$c_owner"; S_GROUP="$c_group"

            # 1. looking the entry up needs x on the directory
            why_eval 1 "$c_mode" "$c_uid" "$c_gid" 1

            if (( ! E_OK )); then
                why_add_step "directory" "$cur" 1
                why_deny "$cur" "no search (x) permission on directory" 1
                WHY_RESOLVED="$cur"
                return 0
            fi

            # 2. the entry must exist
            why_stat "$next" || why_die_stat "$next" "$cur"

            local e_type="$S_TYPE" e_sym="$S_SYM" e_uid="$S_UID"
            local e_owner="$S_OWNER" e_group="$S_GROUP"

            if (( WHY_TRAILING_SLASH )) && [[ "$e_type" != "directory" ]]; then
                error "Not a directory: $next"
            fi

            # 3. deleting needs w AND x on the parent directory
            S_SYM="$c_sym"; S_OWNER="$c_owner"; S_GROUP="$c_group"

            why_eval 1 "$c_mode" "$c_uid" "$c_gid" 3
            why_add_step "parent" "$cur" 3

            WHY_RESOLVED="$next"
            WHY_MOUNT_PATH="$cur"
            WHY_PARENT="$cur"
            WHY_PARENT_LABEL="$E_LABEL"
            WHY_TARGET_TYPE="$e_type"

            if (( ! E_OK )); then
                why_deny "$cur" "no write+search (w+x) permission on directory" 3
                WHY_DEL_DONE=1
                return 0
            fi

            # 4. sticky bit: only the entry's owner, the directory's
            #    owner or root may delete
            local cm
            cm=$(normalize_octal "$c_mode")

            if (( ${cm:0:1} & 1 )); then

                local sk_ok=0 sk_detail

                if (( WHY_UID == 0 )); then
                    sk_ok=1
                    sk_detail="sticky bit is set; root may delete anyway (CAP_FOWNER assumed)"
                elif (( WHY_UID == e_uid )); then
                    sk_ok=1
                    sk_detail="sticky bit is set; $WHY_UNAME owns the entry"
                elif (( WHY_UID == c_uid )); then
                    sk_ok=1
                    sk_detail="sticky bit is set; $WHY_UNAME owns the directory"
                else
                    sk_detail="sticky bit is set: only the owner of the entry ($e_owner), the owner of the directory ($c_owner) or root may delete it; $WHY_UNAME is none of them"
                fi

                why_add_raw "sticky" "$cur" "" "" "sticky" "" "" "" "$sk_ok" "$sk_detail"

                if (( sk_ok )); then
                    WHY_STICKY_TEXT="; $sk_detail"
                else
                    WHY_ALLOWED=0
                    WHY_NOTE=""
                    WHY_REASON="$sk_detail"
                fi
            fi

            # 5. the entry itself (information only)
            local e_detail="no permission on the entry itself is needed to delete it"
            [[ "$e_type" == "directory" ]] &&
                e_detail="no permission on the directory itself is needed to remove it (it must be empty; not checked)"

            why_add_raw "entry" "$next" "$e_sym" "$e_owner:$e_group" "" "" "" "none" "1" "$e_detail"

            WHY_DEL_DONE=1
            return 0
        fi

        # ----------------------------------------------------
        # ordinary component: x on cur, then look the next one up
        # ----------------------------------------------------
        S_SYM="$c_sym"; S_OWNER="$c_owner"; S_GROUP="$c_group"

        why_eval 1 "$c_mode" "$c_uid" "$c_gid" 1
        why_add_step "directory" "$cur" 1

        if (( ! E_OK )); then
            why_deny "$cur" "no search (x) permission on directory" 1
            WHY_RESOLVED="$cur"
            return 0
        fi

        # --- ".." : go to the parent directory ---
        if [[ "$comp" == ".." ]]; then

            if [[ "$cur" != "/" ]]; then
                parent="${cur%/*}"
                [[ -z "$parent" ]] && parent="/"
                cur="$parent"
            fi

            why_stat "$cur" || error "Cannot inspect $cur"

            c_type="$S_TYPE"; c_mode="$S_MODE"; c_uid="$S_UID"; c_gid="$S_GID"
            c_sym="$S_SYM"; c_owner="$S_OWNER"; c_group="$S_GROUP"

            continue
        fi

        why_stat "$next" || why_die_stat "$next" "$cur"

        if [[ "$S_TYPE" == "symbolic link" ]]; then

            (( ++hops > 40 )) &&
                error "Too many levels of symbolic links: $next"

            # Trailing-newline-safe readlink.
            target=$(readlink -- "$next"; printf x)
            target="${target%x}"
            target="${target%$'\n'}"

            why_add_link "$next" "$target"

            if [[ "$target" == /* ]]; then
                cur="/"

                why_stat "/" || error "Cannot inspect /"

                c_type="$S_TYPE"; c_mode="$S_MODE"; c_uid="$S_UID"
                c_gid="$S_GID"; c_sym="$S_SYM"; c_owner="$S_OWNER"
                c_group="$S_GROUP"
            fi

            if [[ -n "$rest" ]]; then
                rest="$target/$rest"
            else
                rest="$target"
            fi

            continue
        fi

        cur="$next"
        c_type="$S_TYPE"; c_mode="$S_MODE"; c_uid="$S_UID"; c_gid="$S_GID"
        c_sym="$S_SYM"; c_owner="$S_OWNER"; c_group="$S_GROUP"

    done

    if (( WHY_DELETE )); then
        error "Cannot delete: PATH must name an entry inside a directory (not /, . or ..)"
    fi

    WHY_RESOLVED="$cur"
    WHY_MOUNT_PATH="$cur"

    # --- the target itself ---
    local isdir=0
    [[ "$c_type" == "directory" ]] && isdir=1

    WHY_TARGET_TYPE="$c_type"

    if (( WHY_TRAILING_SLASH && ! isdir )); then
        error "Not a directory: $cur"
    fi

    case "$WHY_ACTION" in
        read)    WHY_NEED=4 ;;
        write)   (( isdir )) && WHY_NEED=3 || WHY_NEED=2 ;;
        execute) WHY_NEED=1 ;;
    esac

    S_SYM="$c_sym"; S_OWNER="$c_owner"; S_GROUP="$c_group"

    why_eval "$isdir" "$c_mode" "$c_uid" "$c_gid" "$WHY_NEED"
    why_add_step "target" "$cur" "$WHY_NEED"

    if (( ! E_OK )); then
        if [[ "$E_CLASS" == "root" ]]; then
            WHY_ALLOWED=0
            WHY_NOTE=""
            WHY_REASON="no execute bit is set on $cur (root can execute a file only if at least one x bit is set)"
        else
            why_deny "$cur" "insufficient permission on target" "$WHY_NEED"
        fi
    fi

    return 0
}


# Validates the arguments, then runs the walk.
# Sets the WHY_* globals and the WS_* arrays.
why_analyze() {
    local user="$1" action="$2" path="$3"

    case "$action" in
        read|r)       WHY_ACTION="read" ;;
        write|w)      WHY_ACTION="write" ;;
        execute|x)    WHY_ACTION="execute" ;;
        delete|d)     WHY_ACTION="delete" ;;
        *)
            error "Invalid action: $action (use read, write, execute or delete)"
            ;;
    esac

    WHY_DELETE=0
    [[ "$WHY_ACTION" == "delete" ]] && WHY_DELETE=1

    [[ -n "$path" ]] ||
        error "--why requires a path"

    WHY_TRAILING_SLASH=0
    [[ "$path" != "/" && "$path" == */ ]] && WHY_TRAILING_SLASH=1

    why_resolve_user "$user"

    # A relative path is made absolute with the current directory.
    local abs="$path"

    if [[ "$abs" != /* ]]; then
        abs="$(pwd -P)/$abs"
    fi

    WHY_INPUT_PATH="$path"

    why_walk "$abs"

    # Mount options matter for write, execute and delete only.
    M_OK=0

    if [[ "$WHY_ACTION" != "read" && -n "$WHY_MOUNT_PATH" ]]; then
        why_mount_info "$WHY_MOUNT_PATH"
        why_mount_apply
    fi

    why_acl_scan

    if (( WHY_ALLOWED )); then
        if (( WHY_DELETE )); then
            WHY_REASON="$WHY_UNAME can delete $WHY_RESOLVED: w+x on the parent directory $WHY_PARENT ($WHY_PARENT_LABEL class)$WHY_STICKY_TEXT"
        else
            WHY_REASON="$WHY_UNAME can $WHY_ACTION $WHY_RESOLVED: search permission on every directory of the path and $(why_need_str "$WHY_NEED") on the target ($E_LABEL class)"
        fi
    fi
}


why_print_text() {
    local i n="${#WS_KIND[@]}"
    local g gl=""

    for g in "${WHY_GROUPS[@]}"; do
        gl+="$(why_group_name "$g")($g) "
    done

    echo
    echo -e "${BOLD}${BLUE}Effective Access Analysis${RESET}"
    echo "================================"

    echo -e "${BOLD}User    :${RESET} $WHY_UNAME (UID $WHY_UID, GID $WHY_GID)"
    echo -e "${BOLD}Groups  :${RESET} ${gl% }"
    echo -e "${BOLD}Action  :${RESET} $WHY_ACTION"
    echo -e "${BOLD}Path    :${RESET} $WHY_INPUT_PATH"

    if [[ "$WHY_RESOLVED" != "$WHY_INPUT_PATH" ]]; then
        echo -e "${BOLD}Resolved:${RESET} $WHY_RESOLVED"
    fi

    if (( M_OK )); then
        local mo="rw"
        (( M_RO )) && mo="ro"
        (( M_NOEXEC )) && mo+=",noexec"
        echo -e "${BOLD}Mount   :${RESET} $M_POINT ($M_FSTYPE, $mo)"
    fi

    echo
    echo -e "${CYAN}Path Walk${RESET} (search permission x is needed on every directory)"

    for (( i = 0; i < n; i++ )); do

        local tag col

        if [[ "${WS_OK[i]}" == "1" ]]; then
            tag="[OK]    "; col="$GREEN"
        else
            tag="[DENIED]"; col="$RED"
        fi

        case "${WS_KIND[i]}" in

            symlink)
                echo -e "  ${YELLOW}[LINK]${RESET}     ${WS_PATH[i]} -> ${WS_LINK[i]}  (followed; a link's own mode is ignored)"
                ;;

            sticky)
                echo -e "  ${col}${tag}${RESET}  sticky ${WS_PATH[i]}"
                echo "             ${WS_LINK[i]}"
                ;;

            mount)
                echo -e "  ${col}${tag}${RESET}  mount  ${WS_PATH[i]}"
                echo "             ${WS_LINK[i]}"
                ;;

            entry)
                echo -e "  ${YELLOW}[INFO]${RESET}     entry  ${WS_PATH[i]}"
                echo "             ${WS_SYM[i]}  ${WS_OWNER[i]}  ->  ${WS_LINK[i]}"
                ;;

            *)
                local what="x"
                [[ "${WS_KIND[i]}" != "directory" ]] && what="${WS_NEED[i]}"

                local prefix="dir   "
                [[ "${WS_KIND[i]}" == "target" ]] && prefix="target"
                [[ "${WS_KIND[i]}" == "parent" ]] && prefix="parent"

                echo -e "  ${col}${tag}${RESET}  $prefix ${WS_PATH[i]}"
                echo "             ${WS_SYM[i]}  ${WS_OWNER[i]}  ->  ${WS_LABEL[i]} class: ${WS_BITS[i]}   needs: $what"
                ;;
        esac

    done

    echo

    if (( WHY_ALLOWED )); then
        echo -e "${BOLD}Result:${RESET} ${GREEN}ALLOWED${RESET}"
    else
        echo -e "${BOLD}Result:${RESET} ${RED}DENIED${RESET}"
    fi

    echo "  $WHY_REASON"

    if [[ -n "$WHY_NOTE" ]]; then
        echo -e "  ${YELLOW}Note:${RESET} $WHY_NOTE"
    fi

    if (( WHY_UID == 0 )); then
        echo -e "  ${YELLOW}Note:${RESET} uid 0 is assumed to hold all capabilities (CAP_DAC_OVERRIDE)"
    fi

    if (( ${#WHY_ACL_PATHS[@]} > 0 )); then
        local acl_list="" a
        for a in "${WHY_ACL_PATHS[@]}"; do
            [[ -n "$acl_list" ]] && acl_list+=", "
            acl_list+="$a"
        done
        echo -e "  ${YELLOW}Note:${RESET} ACL entries exist on: $acl_list"
        echo "        perm uses only the classic mode bits, so the real answer may differ (check with getfacl)"
    fi

    echo
    echo "Not considered: ACL evaluation, SELinux/AppArmor, capabilities, chattr +i"
    echo
}


why_print_json() {
    local i n="${#WS_KIND[@]}"
    local g first

    echo "{"
    echo "  \"user\": {"
    echo "    \"name\": \"$(json_escape "$WHY_UNAME")\","
    echo "    \"uid\": $WHY_UID,"
    echo "    \"gid\": $WHY_GID,"

    printf '    "groups": ['
    first=1
    for g in "${WHY_GROUPS[@]}"; do
        (( first )) || printf ', '
        printf '%s' "$g"
        first=0
    done
    echo "]"
    echo "  },"

    echo "  \"action\": \"$WHY_ACTION\","
    echo "  \"path\": \"$(json_escape "$WHY_INPUT_PATH")\","
    echo "  \"resolved_path\": \"$(json_escape "$WHY_RESOLVED")\","
    echo "  \"allowed\": $(json_bool "$WHY_ALLOWED"),"
    echo "  \"reason\": \"$(json_escape "$WHY_REASON")\","
    echo "  \"note\": \"$(json_escape "$WHY_NOTE")\","

    echo "  \"acl_detected\": $(json_bool $(( ${#WHY_ACL_PATHS[@]} > 0 ))),"

    printf '  "acl_paths": ['
    first=1
    for g in "${WHY_ACL_PATHS[@]}"; do
        (( first )) || printf ', '
        printf '"%s"' "$(json_escape "$g")"
        first=0
    done
    echo "],"

    if (( M_OK )); then
        echo "  \"mount\": {"
        echo "    \"point\": \"$(json_escape "$M_POINT")\","
        echo "    \"fstype\": \"$(json_escape "$M_FSTYPE")\","
        echo "    \"read_only\": $(json_bool "$M_RO"),"
        echo "    \"noexec\": $(json_bool "$M_NOEXEC")"
        echo "  },"
    else
        echo "  \"mount\": null,"
    fi

    echo "  \"steps\": ["

    for (( i = 0; i < n; i++ )); do

        local sep=","
        (( i == n - 1 )) && sep=""

        case "${WS_KIND[i]}" in

            symlink)
                echo "    {"
                echo "      \"type\": \"symlink\","
                echo "      \"path\": \"$(json_escape "${WS_PATH[i]}")\","
                echo "      \"target\": \"$(json_escape "${WS_LINK[i]}")\""
                echo "    }$sep"
                ;;

            sticky)
                echo "    {"
                echo "      \"type\": \"sticky\","
                echo "      \"path\": \"$(json_escape "${WS_PATH[i]}")\","
                echo "      \"allowed\": $(json_bool "${WS_OK[i]}"),"
                echo "      \"detail\": \"$(json_escape "${WS_LINK[i]}")\""
                echo "    }$sep"
                ;;

            mount)
                echo "    {"
                echo "      \"type\": \"mount\","
                echo "      \"path\": \"$(json_escape "${WS_PATH[i]}")\","
                echo "      \"option\": \"${WS_BITS[i]}\","
                echo "      \"needed\": \"${WS_NEED[i]}\","
                echo "      \"allowed\": $(json_bool "${WS_OK[i]}"),"
                echo "      \"detail\": \"$(json_escape "${WS_LINK[i]}")\""
                echo "    }$sep"
                ;;

            entry)
                echo "    {"
                echo "      \"type\": \"target\","
                echo "      \"path\": \"$(json_escape "${WS_PATH[i]}")\","
                echo "      \"mode\": \"$(json_escape "${WS_SYM[i]}")\","
                echo "      \"owner\": \"$(json_escape "${WS_OWNER[i]}")\","
                echo "      \"class\": \"\","
                echo "      \"class_bits\": \"\","
                echo "      \"needed\": \"none\","
                echo "      \"allowed\": true,"
                echo "      \"detail\": \"$(json_escape "${WS_LINK[i]}")\""
                echo "    }$sep"
                ;;

            *)
                local jtype="${WS_KIND[i]}"
                [[ "$jtype" == "dir" ]] && jtype="directory"
                [[ "$jtype" == "parent" ]] && jtype="parent_directory"

                local need="x"
                [[ "${WS_KIND[i]}" != "directory" ]] && need="${WS_NEED[i]}"

                echo "    {"
                echo "      \"type\": \"$jtype\","
                echo "      \"path\": \"$(json_escape "${WS_PATH[i]}")\","
                echo "      \"mode\": \"$(json_escape "${WS_SYM[i]}")\","
                echo "      \"owner\": \"$(json_escape "${WS_OWNER[i]}")\","
                echo "      \"class\": \"${WS_CLASS[i]}\","
                echo "      \"class_bits\": \"${WS_BITS[i]}\","
                echo "      \"needed\": \"$need\","
                echo "      \"allowed\": $(json_bool "${WS_OK[i]}")"
                echo "    }$sep"
                ;;
        esac

    done

    echo "  ],"

    echo "  \"not_considered\": [\"acl_evaluation\", \"selinux_apparmor\", \"capabilities\", \"chattr_immutable\"]"
    echo "}"
}


# Exit status: 0 = allowed, 1 = denied, 2 = error (from error()).
why_command() {
    local user="$1" action="$2" path="$3" json="$4"

    why_analyze "$user" "$action" "$path"

    if (( json )); then
        why_print_json
    else
        why_print_text
    fi

    (( WHY_ALLOWED )) && return 0

    return 1
}


# ============================================================
# Argument Parser
# ============================================================

MODE="analyze"

TARGET=""
COMPARE_FILE1=""
COMPARE_FILE2=""

JSON_MODE=0
QUIET_MODE=0
REPORT_MODE=0
SECURITY_MODE=0
DIFF_MODE=0

COMPARE_MODE=0
PERMISSIONS_ONLY=0
OWNERSHIP_ONLY=0
SPECIAL_ONLY=0

EXPLAIN_VALUE=""
EXPLAIN_MODE=0

BASELINE_MODE=0
CHECK_MODE=0
FORCE_MODE=0
LIST_MODE=0
REMOVE_MODE=0
STRICT_MODE=0
SCAN_MODE=0
RECURSIVE_MODE=0
CHANGES_ONLY=0

WHY_MODE=0
WHY_ARG_USER=""
WHY_ARG_ACTION=""
WHY_ARG_PATH=""


while [[ $# -gt 0 ]]; do

    case "$1" in

        -h|--help)
            show_help
            exit 0
            ;;

        -v|--version)
            show_version
            exit 0
            ;;

        --explain)
            [[ -n "$2" ]] ||
                error "--explain requires a value"

            MODE="explain"
            EXPLAIN_MODE=1
            EXPLAIN_VALUE="$2"

            shift 2
            ;;

        --compare)
            COMPARE_MODE=1
            MODE="compare"

            shift

            if [[ -z "$COMPARE_FILE1" && -n "$1" &&
                  "$1" != -* ]]; then
                COMPARE_FILE1="$1"
                shift
            fi

            if [[ -z "$COMPARE_FILE2" && -n "$1" &&
                  "$1" != -* ]]; then
                COMPARE_FILE2="$1"
                shift
            fi

            ;;

        --permissions)
            PERMISSIONS_ONLY=1
            shift
            ;;

        --ownership)
            OWNERSHIP_ONLY=1
            shift
            ;;

        --special)
            SPECIAL_ONLY=1
            shift
            ;;

        --diff)
            DIFF_MODE=1
            shift
            ;;

        --json)
            JSON_MODE=1
            shift
            ;;

        --quiet|-q)
            QUIET_MODE=1
            shift
            ;;

        --report)
            REPORT_MODE=1
            MODE="report"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        --baseline)
            BASELINE_MODE=1
            MODE="baseline"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        --scan)
            SCAN_MODE=1
            MODE="scan"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        --check)
            CHECK_MODE=1
            MODE="check"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        --remove)
            REMOVE_MODE=1
            MODE="remove"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        --why)
            WHY_MODE=1
            MODE="why"

            # USER, ACTION and PATH are taken as the next positional
            # arguments (in that order), wherever they appear.
            shift
            ;;

        --list)
            LIST_MODE=1
            MODE="list"
            shift
            ;;

        --recursive)
            RECURSIVE_MODE=1
            shift
            ;;

        --changes-only)
            CHANGES_ONLY=1
            shift
            ;;

        --force)
            FORCE_MODE=1
            shift
            ;;

        --strict)
            STRICT_MODE=1
            shift
            ;;

        --security)
            SECURITY_MODE=1
            MODE="security"

            shift

            if [[ -z "$TARGET" && -n "$1" &&
                  "$1" != -* ]]; then
                TARGET="$1"
                shift
            fi

            ;;

        -*)
            error "Unknown option: $1"
            ;;

        *)
            if (( WHY_MODE )); then

                if [[ -z "$WHY_ARG_USER" ]]; then
                    WHY_ARG_USER="$1"

                elif [[ -z "$WHY_ARG_ACTION" ]]; then
                    WHY_ARG_ACTION="$1"

                elif [[ -z "$WHY_ARG_PATH" ]]; then
                    WHY_ARG_PATH="$1"

                else
                    error "Too many arguments"
                fi

            elif (( COMPARE_MODE )); then

                if [[ -z "$COMPARE_FILE1" ]]; then
                    COMPARE_FILE1="$1"

                elif [[ -z "$COMPARE_FILE2" ]]; then
                    COMPARE_FILE2="$1"

                else
                    error "Too many compare arguments"
                fi

            else

                if [[ -z "$TARGET" ]]; then
                    TARGET="$1"
                else
                    error "Too many arguments"
                fi

            fi

            shift
            ;;

    esac

done


# ============================================================
# Validation
# ============================================================

# In "--scan --check DIR", --check only modifies --scan; it is not a
# separate operation (and it must not win over --scan in MODE).
if (( SCAN_MODE )); then
    MODE="scan"
fi


if (( PERMISSIONS_ONLY + OWNERSHIP_ONLY + SPECIAL_ONLY > 1 )); then
    error "Only one compare filter can be used at a time"
fi


if (( COMPARE_MODE )); then

    [[ -n "$COMPARE_FILE1" ]] ||
        error "--compare requires two files"

    [[ -n "$COMPARE_FILE2" ]] ||
        error "--compare requires two files"

fi


if (( QUIET_MODE && JSON_MODE )); then
    error "--quiet cannot be combined with --json"
fi


if (( QUIET_MODE && COMPARE_MODE )); then
    error "--quiet cannot be combined with --compare"
fi


if (( REPORT_MODE && COMPARE_MODE )); then
    error "--report cannot be combined with --compare"
fi


if (( SECURITY_MODE && COMPARE_MODE )); then
    error "--security cannot be combined with --compare"
fi


if (( DIFF_MODE && !COMPARE_MODE )); then
    error "--diff can only be used with --compare"
fi


if (( JSON_MODE && REPORT_MODE )); then
    error "--json cannot be combined with --report"
fi


if (( JSON_MODE && SECURITY_MODE )); then
    error "--json cannot be combined with --security"
fi


# ------------------------------------------------------------
# Option combinations that would otherwise be silently ignored
# ------------------------------------------------------------

if (( REPORT_MODE && SECURITY_MODE )); then
    error "--report cannot be combined with --security"
fi


if (( QUIET_MODE && REPORT_MODE )); then
    error "--quiet cannot be combined with --report"
fi


if (( QUIET_MODE && SECURITY_MODE )); then
    error "--quiet cannot be combined with --security"
fi


if (( (PERMISSIONS_ONLY || OWNERSHIP_ONLY || SPECIAL_ONLY) && !COMPARE_MODE )); then
    error "--permissions, --ownership and --special can only be used with --compare"
fi


if (( JSON_MODE && COMPARE_MODE &&
      (PERMISSIONS_ONLY || OWNERSHIP_ONLY || SPECIAL_ONLY || DIFF_MODE) )); then
    error "--json --compare does not support --permissions, --ownership, --special or --diff"
fi


if (( SCAN_MODE && STRICT_MODE )); then
    error "--strict cannot be used with --scan (content hashing for directory scans is not supported yet)"
fi


if (( SCAN_MODE && CHECK_MODE && FORCE_MODE )); then
    error "--force cannot be combined with --scan --check"
fi


if (( SCAN_MODE && JSON_MODE && !CHECK_MODE )); then
    error "--json can only be used with --scan --check"
fi


if (( RECURSIVE_MODE && !SCAN_MODE )); then
    error "--recursive can only be used with --scan"
fi


if (( CHANGES_ONLY && !SCAN_MODE )); then
    error "--changes-only can only be used with --scan"
fi


if (( CHANGES_ONLY && JSON_MODE )); then
    error "--changes-only cannot be used with --json (the JSON output always lists every result)"
fi


if (( FORCE_MODE && !BASELINE_MODE && !SCAN_MODE )); then
    error "--force can only be used with --baseline or --scan"
fi


if (( STRICT_MODE && !BASELINE_MODE )); then
    error "--strict can only be used with --baseline"
fi


if (( BASELINE_MODE && JSON_MODE )); then
    error "--json cannot be combined with --baseline"
fi


if (( REMOVE_MODE && JSON_MODE )); then
    error "--json cannot be combined with --remove"
fi


if (( (BASELINE_MODE || CHECK_MODE || LIST_MODE || REMOVE_MODE || SCAN_MODE) && QUIET_MODE )); then
    error "--quiet cannot be combined with --baseline, --check, --list, --remove or --scan"
fi


if (( LIST_MODE )) && [[ -n "$TARGET" ]]; then
    error "--list does not take a path"
fi


if (( EXPLAIN_MODE )); then

    if (( JSON_MODE || QUIET_MODE || COMPARE_MODE ||
          REPORT_MODE || SECURITY_MODE ||
          BASELINE_MODE || CHECK_MODE || SCAN_MODE ||
          LIST_MODE || REMOVE_MODE || WHY_MODE )); then
        error "--explain cannot be combined with other operations"
    fi

    if [[ -n "$TARGET" ]]; then
        error "--explain takes a permission value, not a path"
    fi

fi


if (( WHY_MODE )); then

    if (( BASELINE_MODE || CHECK_MODE || SCAN_MODE || COMPARE_MODE ||
          REPORT_MODE || SECURITY_MODE || LIST_MODE || REMOVE_MODE )); then
        error "--why cannot be combined with other operations"
    fi

    if (( QUIET_MODE )); then
        error "--quiet cannot be combined with --why"
    fi

    if [[ -n "$TARGET" ]]; then
        error "Too many arguments"
    fi

    if [[ -z "$WHY_ARG_USER" || -z "$WHY_ARG_ACTION" ||
          -z "$WHY_ARG_PATH" ]]; then
        error "--why requires USER, ACTION and PATH"
    fi

fi


# --check counts as an operation only when it is not the modifier of --scan.
CHECK_OP=$(( CHECK_MODE && !SCAN_MODE ))

if (( BASELINE_MODE + CHECK_OP + SCAN_MODE + COMPARE_MODE + REPORT_MODE +
      SECURITY_MODE + EXPLAIN_MODE + LIST_MODE + REMOVE_MODE > 1 )); then
    error "Only one operation can be used at a time (--baseline, --check, --scan, --list, --remove, --compare, --report, --security, --explain)"
fi


# ============================================================
# Execute
# ============================================================

case "$MODE" in

    explain)

        explain_octal "$EXPLAIN_VALUE"
        ;;


    report)

        [[ -n "$TARGET" ]] ||
            error "--report requires a path"

        generate_report "$TARGET"
        ;;


    security)

        [[ -n "$TARGET" ]] ||
            error "--security requires a path"

        security_analysis "$TARGET"
        ;;


    baseline)

        [[ -n "$TARGET" ]] ||
            error "--baseline requires a path"

        baseline_create "$TARGET" "$FORCE_MODE" "$STRICT_MODE"

        exit $?
        ;;


    scan)

        [[ -n "$TARGET" ]] ||
            error "--scan requires a directory"

        if (( CHECK_MODE )); then
            if (( JSON_MODE )); then
                scan_check "$TARGET" 1
            else
                scan_check "$TARGET" 0
            fi
        else
            scan_create "$TARGET" "$FORCE_MODE"
        fi

        exit $?
        ;;


    why)

        why_command \
            "$WHY_ARG_USER" \
            "$WHY_ARG_ACTION" \
            "$WHY_ARG_PATH" \
            "$JSON_MODE"

        exit $?
        ;;


    list)

        if (( JSON_MODE )); then
            list_baselines_json
        else
            list_baselines
        fi

        exit $?
        ;;


    remove)

        [[ -n "$TARGET" ]] ||
            error "--remove requires a path"

        baseline_remove "$TARGET"

        exit $?
        ;;


    check)

        [[ -n "$TARGET" ]] ||
            error "--check requires a path"

        if (( JSON_MODE )); then
            check_baseline_json "$TARGET"
        else
            check_baseline "$TARGET"
        fi

        exit $?
        ;;


    compare)

        if (( JSON_MODE )); then

            json_compare \
                "$COMPARE_FILE1" \
                "$COMPARE_FILE2"

            exit $?

        fi

        compare_files \
            "$COMPARE_FILE1" \
            "$COMPARE_FILE2" \
            "$PERMISSIONS_ONLY" \
            "$OWNERSHIP_ONLY" \
            "$SPECIAL_ONLY" \
            "$DIFF_MODE"

        exit $?
        ;;


    analyze)

        [[ -n "$TARGET" ]] ||
            error "No path specified. Use --help for usage."

        if (( JSON_MODE )); then
            json_analyze "$TARGET"
            exit $?
        fi

        if (( QUIET_MODE )); then
            validate_path "$TARGET"
            stat -c '%A' "$TARGET" || exit 2
            exit 0
        fi

        analyze "$TARGET"
        ;;


    *)

        error "Invalid operation"
        ;;

esac